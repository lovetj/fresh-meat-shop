/* pages/checkout/checkout.wxss - 下单结算页 */

.container {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  background-color: var(--bg-cream);
  min-height: 100vh;
}

/* 卡片标题字号与「订单详情」保持一致（28rpx / 800 粗） */
.section-title {
  font-size: 28rpx;
}

/* 标题行内与右侧已选时间标签垂直对齐 */
.time-head-row .section-title {
  margin-bottom: 0;
}

/* ================= 1. 配送方式三选一可爱大图标卡片 ================= */
.delivery-tabs-card {
  display: flex;
  gap: 16rpx;
  margin: 24rpx;
  padding: 16rpx;
  background-color: #FFFFFF;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-warm);
  border: 2rpx solid #FFF2EF;
}

/* 门店营业状态提示：休息中 / 歇业中 */
.shop-state-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0 24rpx 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.state-rest {
  background-color: #FFF7E6;
  border: 2rpx solid #FFE0A3;
  color: #B26A00;
}

.state-closed {
  background-color: #F5F5F5;
  border: 2rpx solid #E0E0E0;
  color: #8C8C8C;
}

.state-bar-icon {
  flex-shrink: 0;
  font-size: 26rpx;
}

.state-bar-text {
  flex: 1;
}

.state-bar-action {
  flex-shrink: 0;
  padding-left: 12rpx;
  font-weight: 700;
  text-decoration: underline;
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 8rpx 20rpx;
  border-radius: 20rpx;
  background-color: var(--bg-pink);
  border: 3rpx solid transparent;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-item:active {
  transform: scale(0.96);
}

.tab-active {
  background-color: #FFF4F4;
  border-color: var(--primary);
  box-shadow: 0 6rpx 18rpx rgba(255, 107, 107, 0.18);
  transform: translateY(-4rpx);
}

/* 选中对勾角标 */
.tab-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 32rpx;
  height: 32rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 800;
  color: #FFFFFF;
  background: var(--primary-gradient);
  border-radius: 50%;
  animation: checkPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.tab-icon {
  font-size: 50rpx;
  line-height: 1.1;
}

.tab-name {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-main);
  white-space: nowrap;
}

.tab-active .tab-name {
  color: var(--primary);
}

.tab-tip {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: var(--text-sub);
}

.tab-active .tab-tip {
  color: var(--primary);
  font-weight: 600;
}

.tab-disabled {
  opacity: 0.55;
  background-color: #F5F5F5;
  border-color: #EEEEEE;
}

.tab-disabled .tab-name,
.tab-disabled .tab-tip {
  color: #999999;
}

/* ================= 2. 自取门店卡片 ================= */
.pickup-box {
  border-top: 6rpx solid var(--cream-yellow);
}

.pickup-shop-info {
  padding: 20rpx;
  border-radius: 20rpx;
  background-color: #FFFBF0;
  border: 2rpx dashed #FFE58F;
  margin-bottom: 8rpx;
}

.pickup-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.pickup-shop-name {
  font-size: 29rpx;
  font-weight: 800;
  color: var(--text-main);
}

.pickup-tag {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-round);
  background-color: rgba(255, 217, 61, 0.3);
  color: #874D00;
  font-size: 19rpx;
  font-weight: 700;
}

.pickup-address {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.4;
}

.pickup-hours {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #D48806;
  font-weight: 600;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #FFF5F2;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
}

.form-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-main);
}

/* ================= 3. 收货地址与测距 ================= */
.address-box {
  border-top: 6rpx solid var(--sky-blue);
}

.address-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background-color: #F7FAFF;
  border: 2rpx dashed #CFE5FF;
}

.addr-content {
  flex: 1;
  min-width: 0;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main);
}

.user-phone {
  font-size: 25rpx;
  color: var(--text-sub);
}

.user-full-addr {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--text-main);
  line-height: 1.4;
  font-weight: 500;
}

.addr-empty {
  flex: 1;
}

.addr-empty-text {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: var(--primary);
}

.addr-empty-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--text-light);
}

.arrow {
  font-size: 28rpx;
  color: #B4B4B4;
  flex-shrink: 0;
}

/* 测距警示条 */
.distance-alert {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
}

.alert-success {
  background-color: #EAF8EE;
  border: 2rpx solid #C6EBD0;
}

.alert-error {
  background-color: #FFF1F0;
  border: 2rpx solid #FFC9C4;
}

.alert-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
  line-height: 1.2;
}

.alert-msg {
  flex: 1;
}

.alert-text {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-main);
}

.alert-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #E03131;
  line-height: 1.4;
}

/* 超出配送范围：可选下单方式快捷入口 */
.range-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.range-action {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid #FFC9C4;
  background-color: #FFFFFF;
  color: #E03131;
  font-size: 22rpx;
  font-weight: 600;
}

.range-action-primary {
  background-color: #FF6B6B;
  border-color: #FF6B6B;
  color: #FFFFFF;
}

/* ================= 4. 商品明细卡片 ================= */
.goods-card {
  padding: 24rpx;
}

.cart-checkout-list {
  display: flex;
  flex-direction: column;
}

.cart-checkout-item {
  display: flex;
  padding: 16rpx 0;
}

.cart-checkout-item.item-bordered {
  border-top: 2rpx dashed #FFF0EB;
}

.goods-row {
  display: flex;
}

.goods-thumb {
  width: 144rpx;
  height: 144rpx;
  flex-shrink: 0;
  border-radius: var(--radius-img);
  background-color: #FFF5F2;
  border: 2rpx solid #FFEDE7;
}

.goods-meta {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-main);
}

.goods-spec {
  align-self: flex-start;
  margin: 8rpx 0;
  padding: 4rpx 14rpx;
  font-size: 21rpx;
  color: var(--text-sub);
  background-color: #FFF9F0;
  border-radius: 10rpx;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goods-qty {
  font-size: 25rpx;
  color: var(--text-sub);
  font-weight: 700;
}

/* ================= 5. 支付方式单选卡片 ================= */
.pay-type-card,
.remark-card,
.fee-card {
  padding: 24rpx;
}

.pay-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pay-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
  background-color: #FFFCFA;
  border: 2rpx solid #FFEAE3;
  transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.pay-option:active {
  transform: scale(0.985);
}

.pay-active {
  background-color: #FFF5F5;
  border-color: var(--primary);
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 107, 0.14);
}

/* 未开通的支付方式：整体置灰且不可点击 */
.pay-option-disabled {
  background-color: #FAFAFA;
  border-color: #EFEFEF;
  opacity: 0.55;
  pointer-events: none;
}

.pay-option-disabled .pay-icon {
  background-color: #F2F2F2;
}

/* 微信图标保持品牌绿（整体已通过 opacity 置灰） */
.pay-option-disabled .pay-icon-wechat {
  background-color: #07C160;
}

.pay-option-disabled .pay-name {
  color: #8C8C8C;
}

.pay-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.pay-soon-tag {
  flex-shrink: 0;
  font-size: 18rpx;
  font-weight: 700;
  color: #9E9E9E;
  background-color: #F0F0F0;
  border-radius: var(--radius-round);
  padding: 2rpx 12rpx;
  line-height: 1.5;
}

.pay-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.pay-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  border-radius: 50%;
  background-color: var(--bg-pink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

/* 微信官方风格图标：绿色底 + 白色双气泡（内联 SVG，免图片资源） */
.pay-icon-wechat {
  background-color: #07C160;
  background-image: url("data:image/svg+xml;base64,");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 62% 62%;
}

.pay-text-wrap {
  flex: 1;
  min-width: 0;
}

.pay-name {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-main);
}

.pay-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--text-sub);
}

/* 当前配送方式无可用的支付方式时的提示 */
.pay-empty-tip {
  display: block;
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #B26A00;
  background-color: #FFF7E6;
  border: 1rpx dashed #FFE0A3;
  border-radius: 14rpx;
}

/* 备注框（多行输入，留足高度便于填写切配要求） */
.remark-input {
  display: block;
  width: 100%;
  height: 200rpx;
  min-height: 200rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-main);
  background-color: #FFF9F5;
  border: 2rpx solid #FFEAE0;
  border-radius: 18rpx;
}

.remark-placeholder {
  font-size: 26rpx;
  color: #C4BDB7;
  line-height: 1.6;
}

/* ================= 6. 费用明细清单 ================= */
.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--text-sub);
}

.fee-val {
  font-weight: 700;
  color: var(--text-main);
}

.fee-free {
  color: var(--mint-green);
}

.fee-total {
  margin-top: 14rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed #FFE0D6;
}

.fee-total .fee-label {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text-main);
}

/* ================= 7. 底部悬浮大胶囊结算栏 ================= */
.submit-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx 0 34rpx;
  background-color: rgba(255, 255, 255, 0.97);
  backdrop-filter: blur(12px);
  border: 2rpx solid #FFEAEA;
  border-radius: var(--radius-round);
  box-shadow: 0 12rpx 36rpx rgba(255, 107, 107, 0.22);
  z-index: 100;
  animation: slideUp 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.submit-left {
  display: flex;
  align-items: baseline;
}

.submit-label {
  font-size: 24rpx;
  color: var(--text-sub);
  font-weight: 600;
  margin-right: 8rpx;
}

.submit-price {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--price-color);
}

.submit-btn {
  height: 84rpx;
  padding: 0 44rpx;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: var(--radius-round);
}

/* ================= 8. 下单成功弹跳动效 ================= */
.success-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(61, 61, 61, 0.4);
  backdrop-filter: blur(3px);
}

.success-card {
  width: 380rpx;
  padding: 40rpx 30rpx 36rpx;
  background-color: #FFFFFF;
  border-radius: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(255, 107, 107, 0.24);
  animation: popIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.success-check {
  width: 120rpx;
  height: 120rpx;
  line-height: 116rpx;
  text-align: center;
  font-size: 64rpx;
  font-weight: 800;
  color: #FFFFFF;
  background: linear-gradient(135deg, #6BCB77 0%, #8FDD9A 100%);
  border-radius: 50%;
  box-shadow: 0 10rpx 24rpx rgba(107, 203, 119, 0.35);
  animation: checkPop 0.5s 0.1s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.success-title {
  margin-top: 22rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main);
}

.success-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--text-sub);
}

/* ================= 9. 阶梯配送与起送规则展示扩展 ================= */
.alert-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.rules-link {
  font-size: 22rpx;
  color: #1890FF;
  font-weight: 700;
  text-decoration: underline;
  flex-shrink: 0;
}

.matched-rule-tag {
  display: inline-block;
  margin-top: 10rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  background-color: #E6F7FF;
  border: 1rpx solid #BAE7FF;
  color: #0050B3;
  font-size: 21rpx;
  font-weight: 600;
}

.short-amount-alert {
  margin-top: 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background-color: #FFFBE6;
  border: 1rpx solid #FFE58F;
  color: #D48806;
  font-size: 22rpx;
  font-weight: 700;
}

.fee-short {
  color: #FA8C16;
  font-weight: 800;
}

.short-notice-bar {
  margin: 16rpx 24rpx;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background-color: #FFF7E6;
  border: 2rpx dashed #FFD591;
  text-align: center;
}

.short-notice-text {
  font-size: 22rpx;
  color: #D46B08;
  font-weight: 700;
}

/* 配送规则弹窗 */
.rules-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(2px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rules-modal-box {
  width: 620rpx;
  max-height: 80vh;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
}

.rules-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.rules-modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main);
}

.rules-modal-close {
  font-size: 36rpx;
  color: #999999;
  padding: 8rpx;
  line-height: 1;
}

.rules-modal-content {
  overflow-y: auto;
  margin-bottom: 24rpx;
}

.rules-modal-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.rules-table {
  border: 1rpx solid #E8E8E8;
  border-radius: 16rpx;
  overflow: hidden;
}

.rules-tr {
  display: flex;
  align-items: center;
  padding: 18rpx 12rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.rules-tr:last-child {
  border-bottom: none;
}

.rules-th {
  background-color: #FAFAFA;
  font-weight: 800;
  color: var(--text-main);
}

.rules-td {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-main);
}

.rules-tr-active {
  background-color: #E6F7FF;
  font-weight: 700;
}

.rules-tr-active .rules-td {
  color: #1890FF;
}

.rules-modal-tips {
  margin-top: 18rpx;
  font-size: 20rpx;
  color: #8C8C8C;
  line-height: 1.4;
}

.rules-modal-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: var(--radius-round);
  background: var(--primary-gradient);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

/* ================= 超范围 / 切换配送方式：底部弹层 ================= */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(2px);
  z-index: 1100;
  display: flex;
  align-items: flex-end;
  animation: sheetMaskIn 0.18s ease-out;
}

.sheet-box {
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 18rpx 32rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
  animation: sheetSlideUp 0.24s cubic-bezier(0.22, 0.68, 0.35, 1);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: #F0E6E1;
  margin: 0 auto 22rpx;
}

.sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.sheet-header-text {
  flex: 1;
  min-width: 0;
}

.sheet-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-main);
  line-height: 1.3;
}

.sheet-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--text-sub);
  line-height: 1.5;
}

.sheet-close {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 30rpx;
  color: #BFB2AC;
}

.sheet-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 26rpx;
}

.sheet-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background-color: #FFF8F5;
  border: 2rpx solid #FFEDE7;
  transition: transform 0.12s ease;
}

.sheet-item:active {
  transform: scale(0.985);
}

.sheet-item.is-primary {
  background: linear-gradient(135deg, #FFF3EE 0%, #FFE4DB 100%);
  border-color: #FFC8B9;
}

.sheet-item-icon {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 32rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 107, 0.12);
}

.sheet-item-main {
  flex: 1;
  min-width: 0;
}

.sheet-item-label {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.3;
}

.sheet-item-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  line-height: 1.4;
}

.sheet-item-arrow {
  flex-shrink: 0;
  font-size: 34rpx;
  color: #D8C7C0;
  line-height: 1;
}

.sheet-cancel {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-round);
  background-color: #F7F2EF;
  color: var(--text-sub);
  font-size: 28rpx;
  font-weight: 700;
}

@keyframes sheetMaskIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes sheetSlideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

/* ================= 期望送达 / 期望到店自取时间 ================= */
.time-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.time-selected {
  flex-shrink: 0;
  height: 40rpx;
  line-height: 40rpx;
  margin-left: 16rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: var(--radius-round);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
}

.time-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #B08D82;
}

.time-day-tabs {
  display: flex;
  white-space: nowrap;
  margin-top: 20rpx;
}

.time-day-tab {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  margin-right: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 18rpx;
  background-color: #FBF6F3;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.time-day-tab.day-active {
  background-color: #FFF4F4;
  border-color: var(--primary);
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 107, 0.16);
}

.day-label {
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.2;
  color: var(--text-main);
}

.day-active .day-label {
  color: var(--primary);
}

.day-date {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: var(--text-sub);
}

/* 折叠容器：默认最多展示 3 行（3 × 66rpx + 2 × 16rpx 间距 = 230rpx） */
.time-slot-wrap {
  position: relative;
  margin-top: 20rpx;
  max-height: 230rpx;
  overflow: hidden;
  transition: max-height 0.25s ease;
}

.time-slot-wrap.is-expanded {
  max-height: none;
}

.time-slot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.time-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 66rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background-color: #FBF6F3;
  border: 2rpx solid transparent;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
}

/* 用 flex 居中，避免 line-height 与边框叠加导致文字偏上/偏下 */
.time-slot-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

/* 「展示全部 / 收起时段」入口 */
.time-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-top: 12rpx;
  padding: 12rpx 0 4rpx;
}

.time-toggle-text {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--primary);
}

.time-toggle-arrow {
  font-size: 26rpx;
  line-height: 1;
  color: var(--primary);
  transition: transform 0.2s ease;
}

.time-toggle-arrow.is-up {
  transform: rotate(180deg);
}

.time-slot.slot-active {
  background: var(--primary-soft);
  border-color: var(--primary);
  color: var(--primary);
}

.time-slot:active {
  transform: scale(0.96);
}

.time-empty {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.6;
}

.time-express-note {
  margin: 0 24rpx 24rpx;
  padding: 16rpx 22rpx;
  border-radius: 16rpx;
  background-color: #F7F4F1;
  color: #8C7A72;
  font-size: 24rpx;
  line-height: 1.5;
}
