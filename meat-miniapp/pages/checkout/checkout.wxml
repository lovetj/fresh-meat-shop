<!-- pages/checkout/checkout.wxml -->
<view class="container">
  <!-- ============ 配送方式三选一：大图标卡片 ============ -->
  <view class="delivery-tabs-card">
    <view class="tab-item {{deliveryType === 1 ? 'tab-active' : ''}}" bindtap="onSelectDeliveryType" data-type="{{1}}">
      <text class="tab-check" wx:if="{{deliveryType === 1}}">✓</text>
      <text class="tab-icon">🏪</text>
      <text class="tab-name">到店自取</text>
      <text class="tab-tip">免配送费</text>
    </view>
    <view class="tab-item {{deliveryType === 2 ? 'tab-active' : ''}} {{shopInfo.merchantDeliveryEnabled === false ? 'tab-disabled' : ''}}" bindtap="onSelectDeliveryType" data-type="{{2}}">
      <text class="tab-check" wx:if="{{deliveryType === 2}}">✓</text>
      <text class="tab-icon">🛵</text>
      <text class="tab-name">商家配送</text>
      <text class="tab-tip">{{shopInfo.merchantDeliveryEnabled === false ? '未开通' : (shopInfo.deliveryRangeText || '阶梯计费')}}</text>
    </view>
    <view class="tab-item {{deliveryType === 4 ? 'tab-active' : ''}} {{shopInfo.expressEnabled !== 1 ? 'tab-disabled' : ''}}" bindtap="onSelectDeliveryType" data-type="{{4}}">
      <text class="tab-check" wx:if="{{deliveryType === 4}}">✓</text>
      <text class="tab-icon">📦</text>
      <text class="tab-name">快递配送</text>
      <text class="tab-tip">{{shopInfo.expressEnabled === 1 ? '快递到家' : '未开通'}}</text>
    </view>
    <view class="tab-item tab-disabled" bindtap="onSelectTakeout">
      <text class="tab-icon">🥡</text>
      <text class="tab-name">外卖配送</text>
      <text class="tab-tip">暂未开通</text>
    </view>
  </view>

  <!-- 1. 自取模式：店铺自提地址与联系人 -->
  <view class="card pickup-box" wx:if="{{deliveryType === 1}}">
    <view class="section-title">🏪 自提门店</view>
    <view class="pickup-shop-info">
      <view class="pickup-title-row">
        <text class="pickup-shop-name">{{shopInfo.name || '鲜肉铺'}}</text>
        <text class="pickup-tag">自提免运费</text>
      </view>
      <text class="pickup-address">📍 {{shopInfo.address || '正在加载地址...'}}</text>
      <text class="pickup-hours">⏰ 营业提货时间：{{shopInfo.businessHours || '06:30 - 20:00'}}</text>
    </view>
    <view class="form-row">
      <text class="form-label">提货人姓名</text>
      <input class="form-input" placeholder="请输入提货人姓名" value="{{pickupName}}" bindinput="onInputPickupName"/>
    </view>
    <view class="form-row">
      <text class="form-label">提货人电话</text>
      <input class="form-input" type="number" placeholder="请输入提货联系电话" value="{{pickupPhone}}" bindinput="onInputPickupPhone"/>
    </view>
  </view>

  <!-- 2. 商家配送 / 快递配送：地址选择（快递配送不校验同城距离） -->
  <view class="card address-box" wx:if="{{deliveryType === 2 || deliveryType === 4}}">
    <view class="section-title">📍 收货地址</view>
    <view class="address-header" bindtap="chooseAddress">
      <view class="addr-content" wx:if="{{selectedAddress}}">
        <view class="user-row">
          <text class="user-name">{{selectedAddress.contactName}}</text>
          <text class="user-phone">{{selectedAddress.contactPhone}}</text>
        </view>
        <text class="user-full-addr">{{selectedAddress.fullAddress}}</text>
      </view>
      <view class="addr-empty" wx:else>
        <text class="addr-empty-text">请选择或添加收货地址</text>
        <text class="addr-empty-sub">支持地图选点，自动测算配送距离</text>
      </view>
      <text class="arrow">></text>
    </view>

    <!-- 快递配送停发地区提示（可发货时不在地址区展示运费，费用在结算明细中体现） -->
    <view class="distance-alert alert-error" wx:if="{{deliveryType === 4 && selectedAddress && expressCheckResult && !expressCheckResult.canDeliver}}">
      <view class="alert-icon">⚠️</view>
      <view class="alert-msg">
        <text class="alert-text">{{expressCheckResult.message}}</text>
        <view class="alert-sub">
          该地区暂停快递发货，请更换收货地址或选择「到店自取」。
        </view>
      </view>
    </view>

    <!-- 配送距离校验状态提示条（仅同城商家配送） -->
    <view class="distance-alert {{distanceCheckResult.canDeliver ? 'alert-success' : 'alert-error'}}" wx:if="{{deliveryType === 2 && selectedAddress && distanceCheckResult}}">
      <view class="alert-icon">{{distanceCheckResult.canDeliver ? '✅' : '⚠️'}}</view>
      <view class="alert-msg">
        <view class="alert-top-row">
          <text class="alert-text">{{distanceCheckResult.message}}</text>
          <text class="rules-link" bindtap="openRulesModal" wx:if="{{distanceCheckResult.deliveryRules && distanceCheckResult.deliveryRules.length > 0}}">规则明细 📋</text>
        </view>
        <view class="matched-rule-tag" wx:if="{{distanceCheckResult.canDeliver && distanceCheckResult.matchedRule}}">
          当前距离 {{distanceCheckResult.distance}}km · 起送价 ¥{{distanceCheckResult.minOrderAmount}} · 配送费 ¥{{distanceCheckResult.deliveryFee}}
        </view>
        <view class="short-amount-alert" wx:if="{{distanceCheckResult.canDeliver && shortAmount > 0}}">
          ⚠️ 商品金额未满起送价，还差 ¥{{shortAmount}} 即可送达
        </view>
        <view class="alert-sub" wx:if="{{!distanceCheckResult.canDeliver}}">
          当前收货地址已超出店铺最大服务范围，可选择下方方式继续下单。
        </view>
        <view class="range-actions" wx:if="{{!distanceCheckResult.canDeliver}}">
          <view class="range-action range-action-primary" bindtap="switchToPickup">🏪 到店自取</view>
          <view class="range-action" wx:if="{{shopInfo.expressEnabled === 1}}" bindtap="switchToExpress">📦 快递配送</view>
          <view class="range-action" bindtap="chooseAddress">📍 更换地址</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 商品明细卡片 -->
  <view class="card goods-card">
    <view class="section-title">🥩 商品明细 {{isCartCheckout ? '（共 ' + cartItems.length + ' 件）' : ''}}</view>

    <!-- 购物车多商品明细展示 -->
    <block wx:if="{{isCartCheckout}}">
      <view class="cart-checkout-list">
        <view class="cart-checkout-item {{index > 0 ? 'item-bordered' : ''}}" wx:for="{{cartItems}}" wx:key="productId">
          <image class="goods-thumb" src="{{item.coverImage || 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=fresh%20pork%20meat%20cuts%20clean%20white%20plate&image_size=square'}}" mode="aspectFill"/>
          <view class="goods-meta">
            <text class="goods-name ellipsis">{{item.name}}</text>
            <text class="goods-spec" wx:if="{{item.specInfo}}">规格：{{item.specInfo}}</text>
            <view class="goods-bottom">
              <view class="price-tag">
                <text class="price-symbol">¥</text>
                <text class="price-value">{{item.price}}</text>
                <text class="price-unit">/{{item.unit || '斤'}}</text>
              </view>
              <text class="goods-qty">x {{item.quantity}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- 单一商品明细展示 -->
    <block wx:else>
      <view class="goods-row">
        <image class="goods-thumb" src="{{product.coverImage}}" mode="aspectFill"/>
        <view class="goods-meta">
          <text class="goods-name ellipsis">{{product.name}}</text>
          <text class="goods-spec">规格：{{specInfo}}</text>
          <view class="goods-bottom">
            <view class="price-tag">
              <text class="price-symbol">¥</text>
              <text class="price-value">{{product.price}}</text>
              <text class="price-unit">/{{product.unit}}</text>
            </view>
            <text class="goods-qty">x {{quantity}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 支付方式选择：单选卡片 -->
  <view class="card pay-type-card">
    <text class="section-title">💳 支付方式</text>
    <radio-group class="pay-group" bindchange="onPayTypeChange">
      <!-- 微信线上支付：功能未上线，先置灰不可选 -->
      <label class="pay-option pay-option-disabled">
        <view class="pay-left">
          <view class="pay-icon pay-icon-wechat"></view>
          <view class="pay-text-wrap">
            <view class="pay-name-row">
              <text class="pay-name">微信线上支付</text>
              <text class="pay-soon-tag">暂未开通</text>
            </view>
            <text class="pay-desc">功能开发中，敬请期待</text>
          </view>
        </view>
        <radio value="1" disabled="{{true}}" color="#FF6B6B"/>
      </label>

      <label class="pay-option {{payType === 2 ? 'pay-active' : ''}}">
        <view class="pay-left">
          <text class="pay-icon">📦</text>
          <view class="pay-text-wrap">
            <text class="pay-name">货到付款</text>
            <text class="pay-desc">送达或到店自提后现场付款</text>
          </view>
        </view>
        <radio value="2" checked="{{payType === 2}}" color="#FF6B6B"/>
      </label>
    </radio-group>
  </view>

  <!-- 下单备注 -->
  <view class="card remark-card">
    <text class="section-title">📝 顾客备注</text>
    <textarea
      class="remark-input"
      placeholder="如：切薄片、排骨剁小块、瘦肉多一点等"
      placeholder-class="remark-placeholder"
      maxlength="100"
      auto-height="{{false}}"
      show-confirm-bar="{{false}}"
      cursor-spacing="24"
      bindinput="onInputRemark"
    ></textarea>
  </view>

  <!-- 费用明细 -->
  <view class="card fee-card">
    <text class="section-title">🧾 费用明细</text>
    <view class="fee-row">
      <text class="fee-label">商品金额</text>
      <text class="fee-val">¥{{goodsAmount}}</text>
    </view>
    <view class="fee-row" wx:if="{{deliveryType === 2 && currentMinOrderAmount > 0}}">
      <text class="fee-label">起送门槛标准</text>
      <text class="fee-val {{shortAmount > 0 ? 'fee-short' : ''}}">
        满¥{{currentMinOrderAmount}}起送 {{shortAmount > 0 ? '(差¥' + shortAmount + ')' : '(已达标)'}}
      </text>
    </view>
    <view class="fee-row">
      <text class="fee-label">{{deliveryType === 4 ? '快递运费' : '同城配送费'}}</text>
      <text class="fee-val {{deliveryType === 1 ? 'fee-free' : ''}}">
        {{deliveryType === 1 ? '¥0.00 (自取免配送费)' : (deliveryType === 4 ? ('¥' + deliveryFee + (expressCheckResult.matchedRegion ? ' (' + expressCheckResult.matchedRegion + '特殊地区)' : '')) : ('¥' + deliveryFee + (distanceCheckResult.distance ? ' (' + distanceCheckResult.distance + 'km)' : '')))}}
      </text>
    </view>
    <view class="fee-row fee-total">
      <text class="fee-label">合计应付</text>
      <view class="price-tag">
        <text class="price-symbol">¥</text>
        <text class="price-value">{{payAmount}}</text>
      </view>
    </view>
  </view>

  <!-- 底部差额温馨提示条 -->
  <view class="short-notice-bar" wx:if="{{deliveryType === 2 && shortAmount > 0}}">
    <text class="short-notice-text">⚠️ 距离本店当前起送额尚差 ¥{{shortAmount}}，建议增加商品数量或凑单</text>
  </view>

  <!-- 底部悬浮结算条 -->
  <view class="submit-bar">
    <view class="submit-left">
      <text class="submit-label">实付款</text>
      <text class="submit-price">¥{{payAmount}}</text>
    </view>
    <button class="btn-primary submit-btn {{isSubmitDisabled ? 'btn-disabled' : ''}}" bindtap="onSubmitOrder" disabled="{{submitting || isSubmitDisabled}}">
      {{submitting ? '提交中...' : submitButtonText}}
    </button>
  </view>

  <!-- 超出配送范围 / 切换配送方式：自定义底部弹层 -->
  <view class="sheet-mask" wx:if="{{showRangePopup}}" bindtap="closeRangePopup">
    <view class="sheet-box" catchtap="preventBubble">
      <view class="sheet-handle"></view>
      <view class="sheet-header">
        <view class="sheet-header-text">
          <text class="sheet-title">{{rangePopup.title}}</text>
          <text class="sheet-sub" wx:if="{{rangePopup.subtitle}}">{{rangePopup.subtitle}}</text>
        </view>
        <text class="sheet-close" bindtap="closeRangePopup">✕</text>
      </view>
      <view class="sheet-list">
        <view
          class="sheet-item {{item.primary ? 'is-primary' : ''}}"
          wx:for="{{rangePopup.options}}"
          wx:key="key"
          bindtap="onRangeOptionTap"
          data-key="{{item.key}}"
        >
          <view class="sheet-item-icon">{{item.icon}}</view>
          <view class="sheet-item-main">
            <text class="sheet-item-label">{{item.label}}</text>
            <text class="sheet-item-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
          </view>
          <text class="sheet-item-arrow">›</text>
        </view>
      </view>
      <view class="sheet-cancel" bindtap="closeRangePopup">取消</view>
    </view>
  </view>

  <!-- 配送规则明细弹窗 -->
  <view class="rules-modal-mask" wx:if="{{showRulesModal}}" bindtap="closeRulesModal">
    <view class="rules-modal-box" catchtap="true">
      <view class="rules-modal-header">
        <text class="rules-modal-title">🛵 同城配送阶梯规则</text>
        <text class="rules-modal-close" bindtap="closeRulesModal">✕</text>
      </view>
      <view class="rules-modal-content">
        <view class="rules-modal-desc">
          店铺根据收货地址的实际测算距离，匹配对应起送金额与配送费：
        </view>
        <view class="rules-table">
          <view class="rules-tr rules-th">
            <text class="rules-td">距离范围</text>
            <text class="rules-td">起送金额</text>
            <text class="rules-td">配送运费</text>
          </view>
          <view class="rules-tr {{distanceCheckResult.matchedRule.id === item.id ? 'rules-tr-active' : ''}}" wx:for="{{distanceCheckResult.deliveryRules || shopInfo.deliveryRules}}" wx:key="id">
            <text class="rules-td">{{(item.maxDistance && item.maxDistance > 0) ? (item.minDistance + 'km - ' + item.maxDistance + 'km') : (item.minDistance + 'km 以上 (不限距离)')}}</text>
            <text class="rules-td">¥{{item.minOrderAmount}}</text>
            <text class="rules-td">¥{{item.deliveryFee}}</text>
          </view>
        </view>
        <view class="rules-modal-tips">
          * 提示：高亮行为当前地址匹配阶梯。若本店设有「不限距离」规则，超出基础范围依然支持送达。
        </view>
      </view>
      <button class="rules-modal-btn" bindtap="closeRulesModal">我知道了</button>
    </view>
  </view>

  <!-- 下单成功：轻量弹跳 + 对勾动画 -->
  <view class="success-mask" wx:if="{{showSuccess}}">
    <view class="success-card">
      <view class="success-check">✓</view>
      <text class="success-title">下单成功</text>
    </view>
  </view>
</view>
