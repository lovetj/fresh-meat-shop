/* pages/login/login.wxss - 微信授权登录页 */

.login-page {
  min-height: 100vh;
  padding: 0 40rpx calc(60rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #FFF3EC 0%, #FFF9F0 40%, #FFF9F0 100%);
  overflow: hidden;
}

/* ================= 1. 品牌区 ================= */
.brand-area {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 70rpx 0 46rpx;
}

.brand-deco {
  position: absolute;
  right: -30rpx;
  top: 10rpx;
  font-size: 130rpx;
  opacity: 0.14;
  transform: rotate(14deg);
  pointer-events: none;
}

.brand-deco-2 {
  position: absolute;
  left: -20rpx;
  bottom: 0;
  font-size: 100rpx;
  opacity: 0.12;
  transform: rotate(-12deg);
  pointer-events: none;
}

.brand-logo {
  width: 150rpx;
  height: 150rpx;
  line-height: 150rpx;
  text-align: center;
  font-size: 82rpx;
  background-color: #FFFFFF;
  border-radius: 46rpx;
  box-shadow: 0 12rpx 32rpx rgba(255, 107, 107, 0.18);
  border: 4rpx solid #FFE4DC;
  animation: floatPiggy 3.2s ease-in-out infinite;
}

.brand-name {
  margin-top: 24rpx;
  font-size: 42rpx;
  font-weight: 800;
  color: var(--text-main);
  letter-spacing: 2rpx;
}

.brand-slogan {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--text-sub);
}

/* ================= 2. 授权卡片 ================= */
.login-card {
  margin-top: 10rpx;
  padding: 44rpx 34rpx 34rpx;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  border: 2rpx solid #FFF2EF;
  box-shadow: 0 12rpx 36rpx rgba(255, 107, 107, 0.12);
  animation: fadeIn 0.32s ease-out;
}

/* 头像授权按钮：外层负责固定正方形定位，内层按钮负责圆形裁剪 */
.avatar-area {
  position: relative;
  width: 172rpx;
  height: 172rpx;
  margin: 0 auto 48rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.avatar-btn {
  display: block;
  position: relative;
  width: 172rpx;
  height: 172rpx;
  min-width: 172rpx;
  max-width: 172rpx;
  min-height: 172rpx;
  max-height: 172rpx;
  margin: 0;
  padding: 0;
  line-height: 1;
  box-sizing: border-box;
  border-radius: 50%;
  background-color: var(--bg-pink);
  border: 4rpx solid #FFDCDC;
  overflow: hidden;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.avatar-btn:active {
  transform: scale(0.95);
}

.avatar-img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 50%;
}

.avatar-icon {
  font-size: 56rpx;
  line-height: 1;
}

.avatar-tip {
  margin-top: 6rpx;
  font-size: 18rpx;
  line-height: 1.3;
  color: var(--text-sub);
  text-align: center;
}

.avatar-camera {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 24rpx;
  background-color: #FFFFFF;
  border: 2rpx solid #FFF2EF;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.2);
  pointer-events: none;
}

/* 昵称授权输入行 */
.input-row {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 26rpx;
  background-color: #FFF9F5;
  border: 2rpx solid #FFEAE0;
  border-radius: 24rpx;
  transition: all 0.22s ease;
}

.input-row.focusing {
  border-color: var(--primary);
  background-color: #FFF6F6;
  box-shadow: 0 0 0 6rpx rgba(255, 107, 107, 0.08);
}

.input-label {
  flex-shrink: 0;
  margin-right: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
}

.input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text-main);
  text-align: left;
}

.input-placeholder {
  font-size: 23rpx;
  color: var(--text-light);
}

/* 协议 */
.agree-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 26rpx;
}

.agree-check {
  width: 34rpx;
  height: 34rpx;
  line-height: 30rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 20rpx;
  font-weight: 800;
  color: #FFFFFF;
  border: 2rpx solid #E0D8D4;
  border-radius: 50%;
  background-color: #FFFFFF;
  transition: all 0.2s ease;
}

.agree-check.checked {
  background: var(--primary-gradient);
  border-color: transparent;
  animation: checkPop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.agree-text {
  flex: 1;
  font-size: 21rpx;
  color: var(--text-sub);
  line-height: 1.4;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  margin-top: 40rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #FFFFFF;
  background: var(--primary-gradient);
  border-radius: var(--radius-round);
  box-shadow: 0 10rpx 26rpx rgba(255, 107, 107, 0.28);
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.login-btn:active {
  transform: scale(0.96);
}

.skip-btn {
  margin-top: 26rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--text-light);
}

/* ================= 3. 掌柜管理员通道入口 ================= */
.admin-entry-divider {
  display: flex;
  align-items: center;
  margin: 36rpx 20rpx 20rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background-color: #F0E6E2;
}

.divider-text {
  padding: 0 16rpx;
  font-size: 20rpx;
  color: #B5A8A4;
}

.admin-entry-link {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 20rpx;
  background-color: #FAF6F4;
  border-radius: var(--radius-round);
  border: 1rpx solid #EFE4E0;
  transition: all 0.2s ease;
}

.admin-entry-link:active {
  background-color: #F0E5E0;
  transform: scale(0.98);
}

.admin-entry-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.admin-entry-text {
  font-size: 23rpx;
  font-weight: 700;
  color: #5C4844;
}

.login-tip {
  display: block;
  margin-top: 36rpx;
  padding: 0 30rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-light);
  line-height: 1.6;
}

/* ================= 4. 超级管理员登录弹窗 ================= */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background-color: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  animation: fadeIn 0.2s ease-out;
}

.modal-dialog {
  width: 100%;
  max-width: 620rpx;
  background-color: #FFFFFF;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.25);
  animation: popIn 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 36rpx 20rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main);
}

.modal-close {
  font-size: 32rpx;
  color: #999999;
  padding: 10rpx;
  line-height: 1;
}

.modal-body {
  padding: 0 36rpx 30rpx;
}

.modal-tips {
  font-size: 23rpx;
  color: #8C8C8C;
  line-height: 1.5;
  background-color: #FAFAFA;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 26rpx;
}

.form-item {
  margin-bottom: 22rpx;
}

.form-label {
  display: block;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #F8F8F8;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  color: #333333;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.form-input:focus {
  background-color: #FFFFFF;
  border-color: #FF8F8F;
}

/* 密码框：默认密文，右侧文字切换明文 */
.pwd-field {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 24rpx;
  background-color: #F8F8F8;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.pwd-input {
  flex: 1;
  width: auto;
  min-width: 0;
  height: 100%;
  padding: 0;
  background-color: transparent;
  border: none;
}

.pwd-toggle {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.pwd-toggle:active {
  transform: scale(0.88);
}

.pwd-eye {
  font-size: 34rpx;
  line-height: 1;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 10rpx 36rpx 36rpx;
}

.modal-btn {
  flex: 1;
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: var(--radius-round);
  font-weight: 700;
}

.cancel-btn {
  color: #666666;
  background-color: #F0F0F0;
}

.submit-btn {
  color: #FFFFFF;
  background: linear-gradient(135deg, #3A2F2F 0%, #251D1D 100%);
  box-shadow: 0 6rpx 20rpx rgba(37, 29, 29, 0.25);
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes popIn {
  from { opacity: 0; transform: scale(0.85); }
  to { opacity: 1; transform: scale(1); }
}
