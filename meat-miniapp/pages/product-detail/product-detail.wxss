/* pages/product-detail/product-detail.wxss - 商品详情页 */

.container {
  padding-bottom: 180rpx;
  background-color: var(--bg-cream);
}

/* ================= 1. 顶部大图与基础信息 ================= */
.banner-wrap {
  position: relative;
  width: 100%;
  height: 520rpx;
  border-radius: 0 0 32rpx 32rpx;
  overflow: hidden;
  background-color: #FFF5F2;
}

.banner-img {
  width: 100%;
  height: 100%;
  display: block;
}

.banner-badge {
  position: absolute;
  left: 24rpx;
  bottom: 60rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-round);
  background-color: rgba(255, 255, 255, 0.94);
  color: #2E9E4F;
  font-size: 21rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.detail-card {
  margin: -44rpx 24rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: var(--radius-card);
  padding: 30rpx 24rpx;
  box-shadow: var(--shadow-warm);
  border: 2rpx solid #FFF0ED;
  position: relative;
  z-index: 10;
}

.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.price-row .price-value {
  font-size: 48rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.title {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-main);
  line-height: 1.35;
}

.stock-chip {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-round);
  background-color: #FFF9E6;
  color: #D48806;
  font-size: 20rpx;
  font-weight: 700;
}

.sales-text {
  font-size: 24rpx;
  color: var(--text-sub);
}

.summary {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 10rpx;
  display: block;
  line-height: 1.4;
}

.price-original {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-light);
  text-decoration: line-through;
}

/* ================= 2. 规格定制与步进器卡片 ================= */
.spec-section, .qty-section, .desc-section {
  padding: 26rpx 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 20rpx;
  display: block;
}

.group-block {
  margin-bottom: 24rpx;
}

.group-block:last-child {
  margin-bottom: 0;
}

.group-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 12rpx;
  display: block;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.spec-tag {
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  background-color: var(--bg-pink);
  border-radius: var(--radius-round);
  color: var(--text-main);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.spec-tag.tag-active {
  background-color: #FFF0F0;
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.2);
}

/* 数量选择 */
.qty-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.qty-section .section-title {
  margin-bottom: 0;
}

.stepper {
  display: flex;
  align-items: center;
  background-color: #FFF5F2;
  border-radius: var(--radius-round);
  padding: 4rpx;
}

.step-btn {
  width: 58rpx;
  height: 58rpx;
  line-height: 54rpx;
  padding: 0;
  font-size: 34rpx;
  background-color: #FFFFFF;
  color: var(--primary);
  font-weight: 800;
  border-radius: var(--radius-round);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.step-btn:active {
  transform: scale(0.9);
}

.step-val {
  min-width: 64rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-main);
  margin: 0 10rpx;
}

/* ================= 3. 鲜肉品质说明与承诺 ================= */
.desc-content {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.shop-promise {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  background-color: #FFF9F5;
  padding: 20rpx;
  border-radius: 18rpx;
  border: 2rpx dashed #FFE5DB;
}

.promise-item {
  font-size: 24rpx;
  color: #D46B08;
  font-weight: 600;
}

/* ================= 4. 底部固定胶囊操作栏 ================= */
.bottom-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  height: 110rpx;
  background-color: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(12px);
  border-radius: var(--radius-round);
  box-shadow: 0 12rpx 36rpx rgba(255, 107, 107, 0.22);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx 0 24rpx;
  z-index: 100;
  border: 2rpx solid #FFEAEA;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
}

.action-icon {
  font-size: 36rpx;
}

.action-text {
  font-size: 20rpx;
  color: var(--text-sub);
  margin-top: 2rpx;
}

.buy-now-btn {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  font-size: 30rpx;
  font-weight: 800;
  border-radius: var(--radius-round);
  margin-left: 20rpx;
}
