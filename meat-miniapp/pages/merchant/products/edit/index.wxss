/* pages/merchant/products/edit/index.wxss - 掌柜商品编辑（Q萌简洁表单） */

.container {
  padding: 24rpx;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  background-color: var(--bg-cream, #FFFBF5);
  min-height: 100vh;
}

/* ================= 表单卡片 ================= */
.form-card {
  margin: 0 0 24rpx;
  padding: 26rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: var(--radius-card, 20rpx);
  border: 2rpx solid #FFF2EF;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 一级标题：卡片标题（左侧主色竖条，字号/字重最高） */
.section-title {
  position: relative;
  display: flex;
  align-items: center;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
  letter-spacing: 0.5rpx;
  color: var(--text-main, #333333);
  margin-bottom: 14rpx;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: var(--primary-gradient, linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%));
}

/* 标题 + 右侧操作按钮：按钮换到单独一行右对齐，避免标题被挤断行 */
.section-header-row {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.section-header-row .section-title {
  margin-bottom: 0;
}

.add-spec-btn {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--primary, #FF6B6B);
  background-color: var(--bg-pink, #FFF5F2);
  border: 1rpx solid #FFD9D9;
  border-radius: var(--radius-round, 999rpx);
}

/* 二级说明文字：卡片标题下的辅助说明 */
.section-desc {
  display: block;
  margin: 10rpx 0 6rpx;
  font-size: 23rpx;
  color: #9A9A9A;
  line-height: 1.6;
}

/* ================= 表单项 ================= */
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #FFF5F2;
}

.form-item:last-child {
  border-bottom: none;
}

.no-cat-box {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  padding: 8rpx 0;
}

.no-cat-text {
  font-size: 22rpx;
  color: #FF6B6B;
  background-color: #FFF2EE;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  border: 1rpx dashed #FF6B6B;
}

.no-cat-arrow {
  font-size: 22rpx;
  color: #FF6B6B;
  margin-left: 6rpx;
}

.form-item-block {
  padding: 22rpx 0 8rpx;
}

/* 可爱小开关 */
.form-item switch {
  transform: scale(0.82);
}

.form-item-img {
  align-items: flex-start;
}

/* 表单标签：介于卡片标题与正文之间 */
.label {
  flex-shrink: 0;
  width: 220rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #5C514C;
  letter-spacing: 0.2rpx;
}

.label.required::before {
  content: '*';
  color: var(--primary, #FF6B6B);
  margin-right: 6rpx;
}

.input {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 500;
  text-align: right;
  color: var(--text-main, #333333);
}

.picker-val {
  font-size: 27rpx;
  text-align: right;
  color: var(--text-main, #333333);
  font-weight: 600;
}

.placeholder {
  color: var(--text-light, #999999);
  font-weight: 400;
}

.textarea {
  width: 100%;
  height: 160rpx;
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--text-main, #333333);
  background-color: #FFF9F5;
  border: 2rpx solid #FFEAE0;
  border-radius: 18rpx;
}

/* ================= 图片上传 ================= */
.img-picker-wrap {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.img-preview-box {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  border-radius: var(--radius-img, 14rpx);
  overflow: hidden;
  border: 2rpx solid #FFEDE7;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.del-img {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  font-size: 20rpx;
  color: #FFFFFF;
  background-color: rgba(61, 61, 61, 0.62);
  border-radius: 0 0 0 16rpx;
}

.upload-btn {
  width: 150rpx;
  height: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #FFF9F5;
  border: 2rpx dashed #FFD0C6;
  border-radius: var(--radius-img, 14rpx);
  transition: transform 0.18s ease;
}

.upload-btn:active {
  transform: scale(0.96);
}

.upload-btn .plus {
  font-size: 46rpx;
  line-height: 1;
  color: var(--primary, #FF6B6B);
}

.upload-btn .tip {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-sub, #666666);
}

/* ================= 加工方式与具体规格配置 ================= */
.spec-action-btns {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
}

.reset-spec-btn {
  font-size: 22rpx;
  color: var(--text-sub, #666666);
  padding: 6rpx 14rpx;
  background-color: #F5F5F5;
  border-radius: var(--radius-round, 999rpx);
}

.process-methods-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-top: 14rpx;
}

.process-method-card {
  background-color: #FFF9F7;
  border: 2rpx solid #FFE4DC;
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
}

.method-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx dashed #FFD4C6;
}

.method-name-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.method-icon {
  font-size: 24rpx;
}

.method-title {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.3rpx;
  color: var(--text-main, #333333);
}

.method-card-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.add-option-btn {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--primary, #FF6B6B);
  background-color: #FFFFFF;
  border: 1rpx solid #FFC5B5;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-round, 999rpx);
}

.del-method-btn {
  font-size: 21rpx;
  color: #999999;
}

.options-tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  align-items: center;
}

.option-tag-item {
  display: flex;
  align-items: center;
  padding: 8rpx 18rpx;
  font-size: 23rpx;
  color: var(--text-main, #333333);
  background-color: #FFFFFF;
  border: 1rpx solid #FFE0D6;
  border-radius: var(--radius-round, 999rpx);
}

.option-del {
  margin-left: 10rpx;
  font-size: 18rpx;
  color: #FF7E7E;
  font-weight: bold;
}

.option-empty-tip {
  font-size: 22rpx;
  color: var(--text-light, #999999);
  padding: 4rpx 0;
}

.spec-empty {
  padding: 20rpx 0;
  font-size: 23rpx;
  color: var(--text-light, #999999);
  text-align: center;
}

/* ================= 底部提交栏 ================= */
.bottom-submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  background-color: rgba(255, 255, 255, 0.97);
  backdrop-filter: blur(12px);
  box-shadow: 0 -8rpx 24rpx rgba(255, 107, 107, 0.12);
}

.bar-two-btns {
  display: flex;
  gap: 20rpx;
}

.btn-delete-prod {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #FF4757;
  background-color: #FFF0F0;
  border: 2rpx solid #FFD0D0;
  border-radius: var(--radius-round, 999rpx);
  margin: 0;
}

.btn-submit {
  flex: 2;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #FFFFFF;
  background: var(--primary-gradient, linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%));
  border-radius: var(--radius-round, 999rpx);
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 107, 0.3);
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
  margin: 0;
}

.btn-submit:active {
  transform: scale(0.97);
}
