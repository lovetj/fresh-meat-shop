/* pages/merchant/orders/orders.wxss - 掌柜订单管理 */

.container {
  padding-bottom: 50rpx;
  background-color: var(--bg-cream);
  min-height: 100vh;
}

/* ================= 1. 搜索框与一键提货码核销 ================= */
.search-filter-box {
  background-color: #FFFFFF;
  padding: 16rpx 24rpx;
  border-bottom: 2rpx solid #FFF2EF;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  background-color: #F8F9FA;
  border-radius: var(--radius-round);
  padding: 10rpx 20rpx;
  border: 1rpx solid #EFEFEF;
}

.verify-action-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  background: var(--primary-gradient);
  color: #FFFFFF;
  padding: 12rpx 22rpx;
  border-radius: var(--radius-round);
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
  box-shadow: 0 4rpx 14rpx rgba(255, 107, 107, 0.3);
  transition: transform 0.2s ease;
}

.verify-action-btn:active {
  transform: scale(0.95);
}

.verify-btn-icon {
  margin-right: 6rpx;
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  color: #888888;
}

.search-input {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-main);
}

.clear-icon {
  font-size: 24rpx;
  color: #999999;
  padding: 4rpx 12rpx;
}

.type-filter-row {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.type-pill {
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-round);
  background-color: #F5F5F5;
  color: var(--text-sub);
  border: 1rpx solid transparent;
  transition: all 0.2s ease;
}

.type-pill.pill-active {
  background-color: #FFF0F0;
  color: var(--primary);
  border-color: #FFCDD2;
  font-weight: 800;
}

/* ================= 3. 顶部横向滚动状态标签 ================= */
.status-tabs-scroll {
  position: sticky;
  top: 0;
  z-index: 10;
  background-color: #FFFFFF;
  white-space: nowrap;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.08);
}

.status-tabs {
  display: inline-flex;
  padding: 16rpx 20rpx;
  gap: 14rpx;
}

.tab-item {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-sub);
  padding: 12rpx 24rpx;
  background-color: var(--bg-pink);
  border-radius: var(--radius-round);
  font-weight: 600;
  transition: all 0.25s ease;
  flex-shrink: 0;
}

.tab-item.tab-active {
  background: var(--primary-gradient);
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(255, 107, 107, 0.3);
  font-weight: 800;
}

.badge {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
  background-color: #FF3B30;
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 1;
  height: 32rpx;
  min-width: 32rpx;
  padding: 0 10rpx;
  border-radius: 16rpx;
  text-align: center;
  font-weight: 800;
  margin-left: 8rpx;
}

.tab-item.tab-active .badge {
  background-color: #FFFFFF;
  color: #D32F2F;
}

/* ================= 4. 订单列表与卡片 ================= */
.order-list {
  padding: 8rpx 0 20rpx;
  box-sizing: border-box;
}

.empty-box {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-main);
  display: block;
}

.empty-sub {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

.order-card {
  margin: 20rpx 24rpx;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-warm);
  border: 2rpx solid #FFF2EF;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  animation: fadeIn 0.3s ease-out;
}

.order-card:active {
  transform: scale(0.985);
}

/* 订单头：配送标签 + 提货码 + 状态软色标签 */
.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx dashed #FFE4DC;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.delivery-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 36rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  font-size: 19rpx;
  line-height: 1;
  font-weight: 700;
  white-space: nowrap;
  border-radius: var(--radius-round);
}

.pickup-pill {
  font-size: 20rpx;
  font-weight: 700;
  color: #FF5722;
  background: #FFF0EB;
  border: 1rpx solid #FFCCBC;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  letter-spacing: 1rpx;
}

.status-chip {
  flex-shrink: 0;
  white-space: nowrap;
}

/* 下单时间 */
.order-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
}

.order-time {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.3;
}

/* 顾客期望送达 / 自取时间：与下单时间垂直居中对齐，并靠右展示 */
.expected-time-chip {
  flex-shrink: 0;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  border-radius: var(--radius-round);
  background-color: var(--primary-soft);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  white-space: nowrap;
}

/* ================= 商品缩略图横排 ================= */
.thumb-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
}

/* 图片区最多占屏幕一半（50vw），避免图片把右侧文案挤压变形 */
.thumb-group {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 50vw;
}

.thumb {
  width: 84rpx;
  height: 84rpx;
  border-radius: 16rpx;
  background-color: #FFF5F2;
  border: 2rpx solid #FFEDE7;
  flex-shrink: 0;
}

/* 商品超出展示数量时的省略号：纯文字，无底色/边框 */
.thumb-more {
  flex-shrink: 0;
  color: var(--text-light);
  font-size: 26rpx;
  line-height: 1;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

.thumb-summary {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.summary-name {
  max-width: 100%;
  font-size: 24rpx;
  color: var(--text-main);
  font-weight: 700;
}

.summary-count {
  font-size: 22rpx;
  color: var(--text-sub);
  background-color: #FFF7F3;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

/* ================= 5. 底部金额与操作按钮 ================= */
.order-footer {
  padding-top: 18rpx;
  border-top: 2rpx dashed #FFE4DC;
}

.total-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 10rpx;
}

.pay-method {
  font-size: 21rpx;
  color: var(--text-light);
  margin-right: auto;
}

.original-amount {
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
  margin-right: 6rpx;
}

.total-amount-label {
  font-size: 23rpx;
  color: var(--text-main);
  font-weight: 600;
}

.total-amount {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--price-color);
}

/* 操作胶囊按钮 */
.action-buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.action-buttons button {
  /* 覆盖微信 button 默认整行宽度，改为按文字内容自适应的小胶囊 */
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: auto;
  min-width: 0;
  max-width: 100%;
  margin: 0;
  padding: 0 22rpx;
  height: 54rpx;
  line-height: 1;
  font-size: 23rpx;
  font-weight: 700;
  white-space: nowrap;
  border-radius: var(--radius-round);
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.action-buttons button:active {
  transform: scale(0.94);
}

.btn-cancel {
  background-color: #FFFFFF;
  color: var(--text-sub);
  border: 2rpx solid #EAEAEA;
}

.btn-price {
  background: linear-gradient(135deg, #FA8C16 0%, #FFA940 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(250, 140, 22, 0.3);
}

.btn-reject {
  background-color: #FFFFFF;
  border: 2rpx solid #FFCCC7;
  color: #F5222D;
}

.btn-accept {
  background: linear-gradient(135deg, #52C41A 0%, #73D13D 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(82, 196, 26, 0.3);
}

.btn-deliver {
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(24, 144, 255, 0.3);
}

.btn-finish {
  background: var(--primary-gradient);
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(255, 107, 107, 0.3);
}

/* 配送相关操作按钮：与本单配送方式标签同色系（1自取橙 / 2同城蓝 / 3外卖紫 / 4快递青） */
.action-buttons .btn-type-1 {
  background: linear-gradient(135deg, #D4380D 0%, #FA8C16 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(212, 56, 13, 0.28);
}

.action-buttons .btn-type-2 {
  background: linear-gradient(135deg, #2F72D6 0%, #4D96FF 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(47, 114, 214, 0.28);
}

.action-buttons .btn-type-3 {
  background: linear-gradient(135deg, #7C5CD6 0%, #9B7BE8 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(124, 92, 214, 0.28);
}

.action-buttons .btn-type-4 {
  background: linear-gradient(135deg, #0B8A6B 0%, #20C997 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(11, 138, 107, 0.28);
}

.load-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: var(--text-light);
}

/* ================= 6. 通用弹窗组件 ================= */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-card {
  width: 100%;
  max-width: 620rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main);
  text-align: center;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  display: block;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.price-origin-tip {
  font-size: 24rpx;
  color: var(--text-sub);
  background-color: #F8F9FA;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.po-amt {
  display: block;
  color: var(--price-color);
  font-weight: 800;
  margin-top: 4rpx;
}

.input-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.modal-input {
  height: 80rpx;
  background-color: #F5F7FA;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--text-main);
  border: 2rpx solid #E4E7ED;
  margin-bottom: 24rpx;
}

.modal-btn-row {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: var(--radius-round);
}

