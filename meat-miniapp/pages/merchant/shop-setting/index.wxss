/* pages/merchant/shop-setting/index.wxss - 掌柜店铺与配送范围设置 */

.container {
  padding: 24rpx;
  padding-bottom: 160rpx;
  background-color: var(--bg-cream);
  min-height: 100vh;
  box-sizing: border-box;
}

.form-card {
  background-color: #FFFFFF;
  border-radius: var(--radius-card);
  padding: 26rpx 24rpx;
  margin: 0 0 24rpx;
  box-shadow: var(--shadow-warm);
  border: 2rpx solid #FFF2EF;
}

/* 一级标题：卡片标题（左侧主色竖条，字号/字重最高，便于与正文区分） */
.section-title {
  position: relative;
  display: flex;
  align-items: center;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
  letter-spacing: 0.5rpx;
  color: var(--text-main);
  margin-bottom: 12rpx;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: var(--primary-gradient);
}

.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.section-header-row .section-title {
  flex: 1 1 auto;
  min-width: 0;
  margin-bottom: 0;
}

.choose-loc-btn {
  flex: 0 0 auto;
  width: auto;
  max-width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--sky-blue);
  background-color: #EBF4FF;
  padding: 8rpx 22rpx;
  border-radius: var(--radius-round);
  margin: 0;
  line-height: 1.4;
  white-space: nowrap;
  font-weight: 700;
  border: 1rpx solid #BAE7FF;
}

/* 二级说明文字：卡片标题下的辅助说明 */
.section-desc {
  display: block;
  font-size: 23rpx;
  line-height: 1.6;
  color: #9A9A9A;
  margin: 10rpx 0 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #FFF5F2;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item-block {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #FFF5F2;
}

.label-wrap {
  display: flex;
  flex-direction: column;
}

/* 表单标签：介于卡片标题与正文之间，字重略轻于标题 */
.label {
  font-size: 27rpx;
  font-weight: 600;
  color: #5C514C;
  letter-spacing: 0.2rpx;
}

.sub-label {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.label.required::before {
  content: '*';
  color: var(--primary);
  margin-right: 6rpx;
}

.input {
  flex: 1;
  font-size: 27rpx;
  font-weight: 500;
  text-align: right;
  color: var(--text-main);
}

/* 时间选择控件样式 */
.time-picker-group {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.time-picker-btn {
  background-color: #FFF9F5;
  border: 2rpx solid #FFE5DB;
  border-radius: 14rpx;
  padding: 10rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 130rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.time-picker-btn:active {
  background-color: #FFEFE8;
  border-color: var(--primary-light);
}

.time-val {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.time-separator {
  margin: 0 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-sub);
}

.highlight-input {
  color: var(--price-color);
  font-weight: 800;
}

.switch-box {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
}

/* 可爱小开关 */
.switch-box switch {
  flex: 0 0 auto;
  transform: scale(0.82);
}

.status-txt {
  display: inline-block;
  flex: 0 0 auto;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  margin-right: 12rpx;
  font-weight: 700;
  white-space: nowrap;
}

.txt-open {
  color: var(--mint-green);
}

.txt-close {
  color: var(--primary);
}

/* 营业状态三态选择 */
.status-seg {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 8rpx;
  background-color: #FFF9F5;
  border: 2rpx solid #FFE5DB;
  border-radius: 16rpx;
}

.seg-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 72rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #999999;
  transition: all 0.15s ease;
}

.seg-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #CCCCCC;
}

.seg-active .seg-dot {
  background-color: #FFFFFF;
}

.seg-active.seg-open {
  background-color: var(--mint-green);
  color: #FFFFFF;
}

.seg-active.seg-rest {
  background-color: #FFA940;
  color: #FFFFFF;
}

.seg-active.seg-closed {
  background-color: #B0B0B0;
  color: #FFFFFF;
}

.status-hint {
  display: block;
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.6;
}

.status-hint-open {
  color: #2E9E4F;
}

.status-hint-rest {
  color: #B26A00;
}

.status-hint-closed {
  color: #8C8C8C;
}

.status-preview {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--text-sub);
}

.preview-val {
  font-weight: 700;
}

.textarea {
  width: 100%;
  height: 140rpx;
  background-color: #FFF9F5;
  border-radius: 16rpx;
  border: 2rpx solid #FFE5DB;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--text-main);
  margin-top: 14rpx;
}

/* ================= 配送方式 × 支付方式开关 ================= */
.pay-config {
  margin-top: 4rpx;
  padding: 16rpx 20rpx;
  background-color: #FFF9F5;
  border: 2rpx solid #FFE5DB;
  border-radius: 16rpx;
}

.pay-config-title {
  display: block;
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 0.3rpx;
  color: #9A9A9A;
  margin-bottom: 6rpx;
}

.pay-switch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed #FFE9E0;
}

.pay-switch-item:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.pay-switch-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.pay-switch-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #5C514C;
}

.pay-switch-desc {
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--text-light);
}

.pay-switch-item switch {
  flex: 0 0 auto;
  transform: scale(0.82);
}

/* 提示卡片 */
.rule-tip-card {
  background-color: #FFFBE6;
  border-left: 8rpx solid #FFD666;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx dashed #FFE58F;
}

.rule-tip-title {
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0.3rpx;
  color: #B26A00;
  margin-bottom: 12rpx;
}

.rule-tip-p {
  display: block;
  font-size: 23rpx;
  line-height: 1.65;
  color: #8C5A00;
  margin-bottom: 8rpx;
}

/* 添加阶梯 / 添加地区按钮（靠右对齐） */
.add-rule-btn {
  flex: 0 0 auto;
  width: auto;
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #FFF1E8;
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
  line-height: 1.4;
  white-space: nowrap;
  border: 2rpx solid #FFD3C4;
  margin: 0 0 0 auto;
}

.rule-list {
  margin-top: 16rpx;
}

.rule-card {
  background-color: #FFF9F5;
  border: 2rpx solid #FFE5DB;
  border-radius: 18rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.rule-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx dashed #FFD6C7;
}

.rule-badge {
  background: var(--primary-gradient);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.rule-range-preview {
  font-size: 24rpx;
  color: var(--text-sub);
  font-weight: 700;
}

.rule-header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rule-unlimited-btn {
  font-size: 21rpx;
  color: #666666;
  background-color: #F0F0F0;
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
  font-weight: 700;
  transition: all 0.2s;
}

.rule-unlimited-btn.btn-active {
  background-color: #E6F7FF;
  color: #1890FF;
  border: 1rpx solid #91D5FF;
}

.rule-del-btn {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 700;
  padding: 4rpx 10rpx;
}

.rule-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx 20rpx;
}

.rule-grid-item {
  display: flex;
  flex-direction: column;
}

/* 阶梯卡片内的字段说明：字号最小、颜色最浅 */
.rule-grid-label {
  font-size: 22rpx;
  font-weight: 500;
  color: #9A9A9A;
  margin-bottom: 8rpx;
}

.rule-grid-label.required::before {
  content: '*';
  color: var(--primary);
  margin-right: 4rpx;
}

.rule-grid-input {
  display: block;
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  line-height: 76rpx;
  background-color: #FFFFFF;
  border: 2rpx solid #FFE1D6;
  border-radius: 12rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--text-main);
  font-weight: 700;
}

.rule-grid-input.disabled {
  background-color: #F8F9FA;
  color: #1890FF;
  border-color: #BAE7FF;
  font-weight: 800;
}

/* 输入框占位提示：弱化颜色与字重，避免与已填数值混淆 */
.rule-input-ph {
  color: #C9C4C0;
  font-size: 24rpx;
  font-weight: 400;
}

/* 底部提交栏 */
.bottom-submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12px);
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(255, 107, 107, 0.12);
  z-index: 50;
}

.btn-submit {
  background: var(--primary-gradient);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
  border-radius: var(--radius-round);
  line-height: 84rpx;
  height: 84rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
}

/* ================= 不限距离提示 ================= */
.unlimited-tip {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background-color: #FFF7F3;
  border: 2rpx dashed #FFD9C9;
}

.unlimited-tip-icon {
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.5;
}

.unlimited-tip-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.5;
  color: #B26A00;
}

/* ================= 快递特殊地区配置 ================= */
.region-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #FFEDE7;
}

/* 三级小标题：卡片内的分组标题 */
.region-head-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #5C514C;
}

.region-list {
  margin-top: 16rpx;
}

.region-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.region-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background-color: #FFF8F5;
  border: 2rpx solid #FFE4DC;
  font-size: 24rpx;
  color: var(--text-main);
  box-sizing: border-box;
}

.region-input.region-fee {
  flex: 0 0 150rpx;
}

/* 可发/停发下拉选择 */
.region-status-picker {
  flex-shrink: 0;
}

.region-status {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 68rpx;
  padding: 0 16rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #2E9E4F;
  background-color: #EAF8EE;
  border: 2rpx solid #C6EBD0;
  box-sizing: border-box;
}

.region-status.is-stop {
  color: #B26A00;
  background-color: #FFF6DF;
  border-color: #FFE3A3;
}

.region-status-arrow {
  font-size: 18rpx;
  line-height: 1;
  opacity: 0.7;
}

.region-del {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light);
}

.region-empty {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-light);
}

/* 特殊地区省份选择器 */
.region-picker {
  flex: 1;
  min-width: 0;
}

.region-picker-btn {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background-color: #FFF8F5;
  border: 2rpx solid #FFE4DC;
  font-size: 24rpx;
  color: var(--text-main);
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.region-picker-btn.is-empty {
  color: var(--text-light);
}
