/* pages/merchant/shop-setting/index.wxss - 维琼鲜肉铺 掌柜店铺与配送范围设置 */

.container {
  padding: 24rpx;
  padding-bottom: 160rpx;
  background-color: var(--bg-cream);
  min-height: 100vh;
  box-sizing: border-box;
}

.form-card {
  background-color: #FFFFFF;
  border-radius: var(--radius-card);
  padding: 26rpx 24rpx;
  margin: 0 0 24rpx;
  box-shadow: var(--shadow-warm);
  border: 2rpx solid #FFF2EF;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.choose-loc-btn {
  font-size: 24rpx;
  color: var(--sky-blue);
  background-color: #EBF4FF;
  padding: 6rpx 22rpx;
  border-radius: var(--radius-round);
  margin: 0;
  line-height: 1.5;
  font-weight: 700;
  border: 1rpx solid #BAE7FF;
}

.section-desc {
  font-size: 22rpx;
  color: var(--text-sub);
  display: block;
  margin-bottom: 16rpx;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #FFF5F2;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item-block {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #FFF5F2;
}

.label-wrap {
  display: flex;
  flex-direction: column;
}

.label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.sub-label {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.label.required::before {
  content: '*';
  color: var(--primary);
  margin-right: 6rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: var(--text-main);
}

/* 时间选择控件样式 */
.time-picker-group {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.time-picker-btn {
  background-color: #FFF9F5;
  border: 2rpx solid #FFE5DB;
  border-radius: 14rpx;
  padding: 10rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 130rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.time-picker-btn:active {
  background-color: #FFEFE8;
  border-color: var(--primary-light);
}

.time-val {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.time-separator {
  margin: 0 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-sub);
}

.highlight-input {
  color: var(--price-color);
  font-weight: 800;
}

.switch-box {
  display: flex;
  align-items: center;
}

/* 可爱小开关 */
.switch-box switch {
  transform: scale(0.82);
}

.status-txt {
  font-size: 26rpx;
  margin-right: 12rpx;
  font-weight: 700;
}

.txt-open {
  color: var(--mint-green);
}

.txt-close {
  color: var(--primary);
}

.textarea {
  width: 100%;
  height: 140rpx;
  background-color: #FFF9F5;
  border-radius: 16rpx;
  border: 2rpx solid #FFE5DB;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--text-main);
  margin-top: 14rpx;
}

/* 提示卡片 */
.rule-tip-card {
  background-color: #FFFBE6;
  border-left: 8rpx solid #FFD666;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx dashed #FFE58F;
}

.rule-tip-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #D48806;
  margin-bottom: 10rpx;
}

.rule-tip-p {
  font-size: 22rpx;
  color: #874D00;
  line-height: 1.5;
  display: block;
  margin-bottom: 6rpx;
}

/* 底部提交栏 */
.bottom-submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12px);
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(255, 107, 107, 0.12);
  z-index: 50;
}

.btn-submit {
  background: var(--primary-gradient);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
  border-radius: var(--radius-round);
  line-height: 84rpx;
  height: 84rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
}
