/* pages/merchant/shop-setting/index.wxss - 鲜肉铺 掌柜店铺与配送范围设置 */

.container {
  padding: 24rpx;
  padding-bottom: 160rpx;
  background-color: var(--bg-cream);
  min-height: 100vh;
  box-sizing: border-box;
}

.form-card {
  background-color: #FFFFFF;
  border-radius: var(--radius-card);
  padding: 26rpx 24rpx;
  margin: 0 0 24rpx;
  box-shadow: var(--shadow-warm);
  border: 2rpx solid #FFF2EF;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.section-header-row .section-title {
  flex: 1 1 auto;
  min-width: 0;
  margin-bottom: 0;
}

.choose-loc-btn {
  flex: 0 0 auto;
  width: auto;
  max-width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--sky-blue);
  background-color: #EBF4FF;
  padding: 8rpx 22rpx;
  border-radius: var(--radius-round);
  margin: 0;
  line-height: 1.4;
  white-space: nowrap;
  font-weight: 700;
  border: 1rpx solid #BAE7FF;
}

.section-desc {
  font-size: 22rpx;
  color: var(--text-sub);
  display: block;
  margin: 10rpx 0 16rpx;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #FFF5F2;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item-block {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #FFF5F2;
}

.label-wrap {
  display: flex;
  flex-direction: column;
}

.label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.sub-label {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.label.required::before {
  content: '*';
  color: var(--primary);
  margin-right: 6rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: var(--text-main);
}

/* 时间选择控件样式 */
.time-picker-group {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.time-picker-btn {
  background-color: #FFF9F5;
  border: 2rpx solid #FFE5DB;
  border-radius: 14rpx;
  padding: 10rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 130rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.time-picker-btn:active {
  background-color: #FFEFE8;
  border-color: var(--primary-light);
}

.time-val {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.time-separator {
  margin: 0 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-sub);
}

.highlight-input {
  color: var(--price-color);
  font-weight: 800;
}

.switch-box {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
}

/* 可爱小开关 */
.switch-box switch {
  flex: 0 0 auto;
  transform: scale(0.82);
}

.status-txt {
  display: inline-block;
  flex: 0 0 auto;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  margin-right: 12rpx;
  font-weight: 700;
  white-space: nowrap;
}

.txt-open {
  color: var(--mint-green);
}

.txt-close {
  color: var(--primary);
}

.textarea {
  width: 100%;
  height: 140rpx;
  background-color: #FFF9F5;
  border-radius: 16rpx;
  border: 2rpx solid #FFE5DB;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--text-main);
  margin-top: 14rpx;
}

/* 提示卡片 */
.rule-tip-card {
  background-color: #FFFBE6;
  border-left: 8rpx solid #FFD666;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx dashed #FFE58F;
}

.rule-tip-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #D48806;
  margin-bottom: 10rpx;
}

.rule-tip-p {
  font-size: 22rpx;
  color: #874D00;
  line-height: 1.5;
  display: block;
  margin-bottom: 6rpx;
}

/* 添加阶梯 / 添加地区按钮（靠右对齐） */
.add-rule-btn {
  flex: 0 0 auto;
  width: auto;
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #FFF1E8;
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
  line-height: 1.4;
  white-space: nowrap;
  border: 2rpx solid #FFD3C4;
  margin: 0 0 0 auto;
}

.rule-list {
  margin-top: 16rpx;
}

.rule-card {
  background-color: #FFF9F5;
  border: 2rpx solid #FFE5DB;
  border-radius: 18rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.rule-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx dashed #FFD6C7;
}

.rule-badge {
  background: var(--primary-gradient);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.rule-range-preview {
  font-size: 24rpx;
  color: var(--text-sub);
  font-weight: 700;
}

.rule-header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rule-unlimited-btn {
  font-size: 21rpx;
  color: #666666;
  background-color: #F0F0F0;
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
  font-weight: 700;
  transition: all 0.2s;
}

.rule-unlimited-btn.btn-active {
  background-color: #E6F7FF;
  color: #1890FF;
  border: 1rpx solid #91D5FF;
}

.rule-del-btn {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 700;
  padding: 4rpx 10rpx;
}

.rule-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx 20rpx;
}

.rule-grid-item {
  display: flex;
  flex-direction: column;
}

.rule-grid-label {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-bottom: 8rpx;
}

.rule-grid-label.required::before {
  content: '*';
  color: var(--primary);
  margin-right: 4rpx;
}

.rule-grid-input {
  display: block;
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  line-height: 76rpx;
  background-color: #FFFFFF;
  border: 2rpx solid #FFE1D6;
  border-radius: 12rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--text-main);
  font-weight: 700;
}

.rule-grid-input.disabled {
  background-color: #F8F9FA;
  color: #1890FF;
  border-color: #BAE7FF;
  font-weight: 800;
}

/* 输入框占位提示：弱化颜色与字重，避免与已填数值混淆 */
.rule-input-ph {
  color: #C9C4C0;
  font-size: 24rpx;
  font-weight: 400;
}

/* 底部提交栏 */
.bottom-submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12px);
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(255, 107, 107, 0.12);
  z-index: 50;
}

.btn-submit {
  background: var(--primary-gradient);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
  border-radius: var(--radius-round);
  line-height: 84rpx;
  height: 84rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
}

/* ================= 不限距离提示 ================= */
.unlimited-tip {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background-color: #FFF7F3;
  border: 2rpx dashed #FFD9C9;
}

.unlimited-tip-icon {
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.5;
}

.unlimited-tip-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.5;
  color: #B26A00;
}

/* ================= 快递特殊地区配置 ================= */
.region-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #FFEDE7;
}

.region-head-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
}

.region-list {
  margin-top: 16rpx;
}

.region-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.region-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background-color: #FFF8F5;
  border: 2rpx solid #FFE4DC;
  font-size: 24rpx;
  color: var(--text-main);
  box-sizing: border-box;
}

.region-input.region-fee {
  flex: 0 0 150rpx;
}

/* 可发/停发下拉选择 */
.region-status-picker {
  flex-shrink: 0;
}

.region-status {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 68rpx;
  padding: 0 16rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #2E9E4F;
  background-color: #EAF8EE;
  border: 2rpx solid #C6EBD0;
  box-sizing: border-box;
}

.region-status.is-stop {
  color: #B26A00;
  background-color: #FFF6DF;
  border-color: #FFE3A3;
}

.region-status-arrow {
  font-size: 18rpx;
  line-height: 1;
  opacity: 0.7;
}

.region-del {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light);
}

.region-empty {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-light);
}

/* 特殊地区省份选择器 */
.region-picker {
  flex: 1;
  min-width: 0;
}

.region-picker-btn {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background-color: #FFF8F5;
  border: 2rpx solid #FFE4DC;
  font-size: 24rpx;
  color: var(--text-main);
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.region-picker-btn.is-empty {
  color: var(--text-light);
}
