<!-- pages/merchant/shop-setting/index.wxml -->
<view class="container">
  <form bindsubmit="onSubmitShopInfo">
    <!-- 基础营业信息 -->
    <view class="card form-card">
      <view class="section-title">🏪 门店营业基础信息</view>

      <view class="form-item">
        <text class="label required">店铺名称</text>
        <input class="input" name="name" placeholder="如：鲜肉铺 (总店)" value="{{shop.name}}"/>
      </view>

      <view class="form-item">
        <text class="label required">客服/联系电话</text>
        <input class="input" name="phone" placeholder="如：13800000000" value="{{shop.phone}}"/>
      </view>

      <view class="form-item">
        <text class="label required">每日营业时间</text>
        <view class="time-picker-group">
          <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
            <view class="time-picker-btn">
              <text class="time-val">{{startTime || '06:00'}}</text>
            </view>
          </picker>
          <text class="time-separator">至</text>
          <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
            <view class="time-picker-btn">
              <text class="time-val">{{endTime || '19:30'}}</text>
            </view>
          </picker>
        </view>
        <input name="businessHours" value="{{shop.businessHours}}" style="display:none;"/>
      </view>

      <view class="form-item form-item-switch">
        <text class="label">营业状态</text>
        <view class="switch-box">
          <text class="status-txt {{shop.status === 1 ? 'txt-open' : 'txt-close'}}">{{shop.status === 1 ? '正常营业' : '暂停歇业'}}</text>
          <switch checked="{{shop.status === 1}}" color="#FF6B6B" bindchange="onStatusChange"/>
        </view>
      </view>

      <view class="form-item-block">
        <text class="label">店铺公告 (顾客端顶部展示)</text>
        <textarea class="textarea" name="notice" placeholder="如：每日清晨现宰鲜肉直达，支持切片绞肉，同城5公里极速送达！" value="{{shop.notice}}"/>
      </view>
    </view>

    <!-- 门店实体定位设置 -->
    <view class="card form-card">
      <view class="section-header-row">
        <view class="section-title">📍 门店地址</view>
        <button class="choose-loc-btn" bindtap="chooseLocationOnMap">🗺️ 地图选点</button>
      </view>
      <text class="section-desc">此坐标用于计算顾客下单收货地址距离，请务必准确定位</text>

      <view class="form-item">
        <text class="label required">门店详细地址</text>
        <input class="input" name="address" placeholder="如：广东省广州市天河区石牌东路88号" value="{{shop.address}}"/>
      </view>

      <view class="form-item">
        <text class="label required">经度 (Longitude)</text>
        <input class="input" name="longitude" type="digit" placeholder="如：113.342123" value="{{shop.longitude}}"/>
      </view>

      <view class="form-item">
        <text class="label required">纬度 (Latitude)</text>
        <input class="input" name="latitude" type="digit" placeholder="如：23.134567" value="{{shop.latitude}}"/>
      </view>
    </view>

    <!-- 同城配送规则配置 (多阶梯多区间) -->
    <view class="card form-card">
      <view class="section-header-row">
        <view class="section-title">🛵 同城商家配送</view>
        <view class="switch-box">
          <text class="status-txt {{merchantDeliveryEnabled === 1 ? 'txt-open' : 'txt-close'}}">{{merchantDeliveryEnabled === 1 ? '已开通' : '未开通'}}</text>
          <switch checked="{{merchantDeliveryEnabled === 1}}" color="#FF6B6B" bindchange="onMerchantDeliveryChange"/>
        </view>
      </view>
      <text class="section-desc">开通后顾客下单可选择「商家配送」，按距离阶梯收取配送费并校验起送价；关闭后顾客仅可选择「到店自取」或「快递配送」</text>

      <block wx:if="{{merchantDeliveryEnabled === 1}}">
        <view class="region-head-row">
          <text class="region-head-title">配送阶梯范围</text>
          <view class="add-rule-btn" bindtap="addDeliveryRule">+ 添加阶梯</view>
        </view>
        <text class="section-desc">支持不同距离配置不同配送费与起送价；阶梯需首尾衔接（第 1 段从 0km 开始，后一段起始距离须等于前一段截止距离），超出最后一档截止距离即不提供同城配送</text>

        <view class="rule-list">
        <view class="rule-card" wx:for="{{deliveryRules}}" wx:key="index">
          <view class="rule-card-header">
            <view class="rule-badge">阶梯 {{index + 1}}</view>
            <view class="rule-range-preview">
              {{item.minDistance}}km - {{item.maxDistance}}km
            </view>
            <view class="rule-header-actions">
              <view class="rule-del-btn" bindtap="deleteDeliveryRule" data-index="{{index}}" wx:if="{{deliveryRules.length > 1}}">
                🗑️ 删除
              </view>
            </view>
          </view>

          <view class="rule-form-grid">
            <view class="rule-grid-item">
              <text class="rule-grid-label required">起始距离(km)</text>
              <input class="rule-grid-input" type="digit" placeholder-class="rule-input-ph" placeholder="如 0" value="{{item.minDistance}}" data-index="{{index}}" data-field="minDistance" bindinput="onRuleFieldInput"/>
            </view>
            <view class="rule-grid-item">
              <text class="rule-grid-label required">截止距离(km)</text>
              <input class="rule-grid-input" type="digit" placeholder-class="rule-input-ph" placeholder="如 3.0" value="{{item.maxDistance}}" data-index="{{index}}" data-field="maxDistance" bindinput="onRuleFieldInput"/>
            </view>
            <view class="rule-grid-item">
              <text class="rule-grid-label">起送金额(元)</text>
              <input class="rule-grid-input" type="digit" placeholder-class="rule-input-ph" placeholder="如 20.0" value="{{item.minOrderAmount}}" data-index="{{index}}" data-field="minOrderAmount" bindinput="onRuleFieldInput"/>
            </view>
            <view class="rule-grid-item">
              <text class="rule-grid-label">配送费(元)</text>
              <input class="rule-grid-input" type="digit" placeholder-class="rule-input-ph" placeholder="如 3.0" value="{{item.deliveryFee}}" data-index="{{index}}" data-field="deliveryFee" bindinput="onRuleFieldInput"/>
            </view>
          </view>
        </view>
      </view>
      </block>

      <text class="region-empty" wx:else>同城商家配送已关闭，顾客无法选择商家配送下单；已配置的阶梯在重新开启后继续生效</text>
    </view>

    <!-- 快递配送配置 -->
    <view class="card form-card">
      <view class="section-header-row">
        <view class="section-title">📦 快递配送与特殊地区</view>
        <view class="switch-box">
          <text class="status-txt {{expressEnabled === 1 ? 'txt-open' : 'txt-close'}}">{{expressEnabled === 1 ? '已开通' : '未开通'}}</text>
          <switch checked="{{expressEnabled === 1}}" color="#FF6B6B" bindchange="onExpressEnabledChange"/>
        </view>
      </view>
      <text class="section-desc">开通后顾客下单可选择快递配送，掌柜接单后手动填写快递公司与单号发货。特殊地区可单独设置运费，或直接停发</text>

      <view class="form-item" wx:if="{{expressEnabled === 1}}">
        <text class="label">快递基础运费(元)</text>
        <input class="input" type="digit" placeholder="如 8.00，0 表示包邮" value="{{expressFee}}" bindinput="onExpressFeeInput"/>
      </view>

      <block wx:if="{{expressEnabled === 1}}">
        <view class="region-head-row">
          <text class="region-head-title">特殊地区规则</text>
          <view class="add-rule-btn" bindtap="addExpressRegion">+ 添加地区</view>
        </view>

        <view class="region-list" wx:if="{{expressRegions.length > 0}}">
          <view class="region-item" wx:for="{{expressRegions}}" wx:key="index">
            <picker
              class="region-picker"
              mode="region"
              level="province"
              data-index="{{index}}"
              bindchange="onExpressRegionPick"
            >
              <view class="region-picker-btn {{item.region ? '' : 'is-empty'}}">
                {{item.region || '请选择省份'}}
              </view>
            </picker>
            <input
              class="region-input region-fee"
              type="digit"
              placeholder="运费(元)"
              value="{{item.fee}}"
              data-index="{{index}}"
              data-field="fee"
              bindinput="onExpressRegionInput"
            />
            <picker
              class="region-status-picker"
              mode="selector"
              range="{{deliverOptions}}"
              value="{{item.deliverable === 0 ? 1 : 0}}"
              data-index="{{index}}"
              bindchange="onExpressRegionDeliverableChange"
            >
              <view class="region-status {{item.deliverable === 0 ? 'is-stop' : ''}}">
                <text>{{item.deliverable === 0 ? '停发' : '可发'}}</text>
                <text class="region-status-arrow">▾</text>
              </view>
            </picker>
            <view class="region-del" bindtap="deleteExpressRegion" data-index="{{index}}">✕</view>
          </view>
        </view>
        <text class="region-empty" wx:else>暂无特殊地区，所有地区按基础运费配送</text>
      </block>
    </view>

    <!-- 外卖配送配置（需求待定，暂仅作配置预留） -->
    <view class="card form-card">
      <view class="section-header-row">
        <view class="section-title">🥡 外卖配送</view>
        <view class="switch-box">
          <text class="status-txt {{takeoutEnabled === 1 ? 'txt-open' : 'txt-close'}}">{{takeoutEnabled === 1 ? '已开通' : '未开通'}}</text>
          <switch checked="{{takeoutEnabled === 1}}" color="#FF6B6B" bindchange="onTakeoutEnabledChange"/>
        </view>
      </view>
      <text class="section-desc">第三方外卖平台对接需求尚未确认，当前仅保留开关配置；开启后顾客端「外卖配送」下单方式暂不开放，待需求明确后再接入</text>
    </view>

    <!-- 配送距离计算原理说明 -->
    <view class="rule-tip-card">
      <view class="rule-tip-title">ℹ️ 配送方式说明</view>
      <text class="rule-tip-p">1. 同城商家配送：系统基于 Haversine 大圆距离公式对收货地址与门店坐标实时测距，落入对应阶梯后按该阶梯收取配送费并校验起送价。</text>
      <text class="rule-tip-p">2. 每一档阶梯都必须填写明确的截止距离；超出最后一档截止距离的地址不再提供同城配送，可提示顾客改为「到店自取」或「快递配送」。</text>
      <text class="rule-tip-p">3. 快递配送：运费按「基础运费 + 特殊地区规则」计算；命中停发地区的地址无法下单快递，可提示顾客更换地址。</text>
      <text class="rule-tip-p">4. 外卖配送：第三方外卖平台对接需求待定，当前仅保留开关配置，暂不影响顾客下单方式。</text>
    </view>

    <!-- 底部保存按钮 -->
    <view class="bottom-submit-bar">
      <button class="btn-submit" form-type="submit" loading="{{submitting}}">保存店铺设置</button>
    </view>
  </form>
</view>
