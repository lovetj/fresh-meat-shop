/* pages/order-detail/order-detail.wxss - 订单详情页 */

.container {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  background-color: var(--bg-cream);
  min-height: 100vh;
}

/* 无可执行操作时不渲染悬浮栏，底部只留安全间距 */
.container.no-actions {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ================= 1. 顶部Q萌状态渐变横幅 ================= */
.status-banner {
  background: linear-gradient(135deg, #FF6B6B 0%, #FFA07A 100%);
  padding: 36rpx 30rpx 44rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #FFFFFF;
  border-radius: 0 0 36rpx 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.2);
  position: relative;
  overflow: hidden;
}

.status-banner::after {
  content: "🥩";
  position: absolute;
  right: 120rpx;
  bottom: -20rpx;
  font-size: 100rpx;
  opacity: 0.15;
  pointer-events: none;
}

.status-left {
  flex: 1;
}

.banner-title {
  font-size: 38rpx;
  font-weight: 800;
  display: block;
  letter-spacing: 1rpx;
}

.banner-sub {
  font-size: 24rpx;
  color: #FFF3F0;
  margin-top: 8rpx;
  display: block;
  line-height: 1.4;
}

.status-icon {
  font-size: 72rpx;
  margin-left: 20rpx;
  animation: floatPiggy 3s ease-in-out infinite;
}

/* ================= 1.1 提货核销凭证（自提提货码） ================= */
/* 卡片头部：待提货核销 / 已核销提货 状态标签 */
.p-card-head {
  display: flex;
  align-items: center;
}

.p-card-status {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-round);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}

.status-wait {
  color: #B26A00;
  background-color: #FFF6DF;
  border: 2rpx solid #FFE3A3;
}

.status-done {
  color: #2E9E4F;
  background-color: #EAF8EE;
  border: 2rpx solid #C6EBD0;
}

.p-card-tip {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-sub);
}

.p-code-box {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 12rpx 0 16rpx;
  padding: 18rpx 24rpx;
  background-color: #FFF6F2;
  border: 2rpx dashed #FFC9B8;
  border-radius: var(--radius-tag);
}

.p-code-label {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 提货码数字：放大加粗、字距拉开，方便对照报码 */
.p-code-val {
  flex: 1;
  min-width: 0;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.1;
  letter-spacing: 10rpx;
  color: var(--primary);
  font-family: "DIN Alternate", "SF Mono", Menlo, Consolas, monospace;
  text-shadow: 0 4rpx 10rpx rgba(255, 107, 107, 0.16);
}

/* ================= 1.2 快递配送物流信息 ================= */
.express-card {
  position: relative;
  z-index: 12;
}

.express-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.express-label {
  flex-shrink: 0;
  width: 130rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.express-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
}

/* 快递单号：等宽字体便于核对与电话报号 */
.express-no {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: var(--text-main);
  font-family: "DIN Alternate", "SF Mono", Menlo, Consolas, monospace;
  word-break: break-all;
}

.copy-btn-mini {
  flex-shrink: 0;
  padding: 4rpx 18rpx;
  border-radius: var(--radius-round);
  background-color: var(--bg-pink);
  border: 2rpx solid #FFD9D0;
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.4;
}

/* 物流查询提示：引导打开菜鸟/快递公司 App */
.express-hint {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background-color: #FFF7F3;
  border: 2rpx dashed #FFD9C9;
}

.express-hint-icon {
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.5;
}

.express-hint-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.5;
  color: #B26A00;
}

.express-empty {
  display: block;
  margin-top: 16rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--text-sub);
}

/* 快递发货弹窗：常用快递公司快捷选择 */
.express-company-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.express-chip {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-round);
  background-color: #FFF5F2;
  border: 2rpx solid #FFE4DC;
  font-size: 22rpx;
  color: var(--text-main);
}

.express-chip-active {
  background: var(--primary-gradient);
  border-color: transparent;
  color: #FFFFFF;
  font-weight: 700;
}

/* ================= 居中弹窗（掌柜改价 / 快递发货） ================= */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(61, 61, 61, 0.5);
  backdrop-filter: blur(4px);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-card {
  width: 100%;
  max-width: 620rpx;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.16);
  animation: popIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main);
  text-align: center;
  margin-bottom: 16rpx;
}

.modal-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--text-sub);
  margin-bottom: 24rpx;
}

.modal-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background-color: #F5F7FA;
  border: 2rpx solid #E4E7ED;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 20rpx;
}

.modal-btn-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 8rpx;
}

.modal-btn {
  flex: 1;
  width: auto;
  height: 76rpx;
  line-height: 1;
  padding: 0 20rpx;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: var(--radius-round);
}

/* ================= 2. 配送/自取信息卡片 ================= */
.delivery-card {
  margin-top: -20rpx;
  position: relative;
  z-index: 10;
}

.delivery-head-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.delivery-type-tag {
  display: inline-block;
  flex-shrink: 0;
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-round);
  font-weight: 700;
  white-space: nowrap;
}

.shop-bind-tag {
  min-width: 0;
  max-width: 62%;
  font-size: 20rpx;
  line-height: 1;
  color: var(--text-sub);
  background-color: #FFF7F3;
  border: 1rpx solid #FFE0D6;
  padding: 5rpx 14rpx;
  border-radius: var(--radius-round);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 自取：提货人姓名 / 电话 */
.contact-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0;
}

.contact-label {
  flex-shrink: 0;
  width: 130rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.contact-name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main);
}

.contact-phone {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  letter-spacing: 0.5rpx;
}

.call-btn-mini {
  flex-shrink: 0;
  margin-left: auto;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
  color: var(--primary, #FF6B6B);
  background-color: #FFF0F0;
  border: 1rpx solid #FFCCD0;
  padding: 8rpx 22rpx;
  border-radius: var(--radius-round);
  white-space: nowrap;
}

/* 顾客端自提：导航按钮 */
.nav-btn {
  flex-shrink: 0;
  margin-left: auto;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
  color: #2E7D32;
  background-color: #EAF7EE;
  border: 1rpx solid #CDEBD6;
  padding: 8rpx 22rpx;
  border-radius: var(--radius-round);
  white-space: nowrap;
}

.user-info-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main);
}

.user-phone {
  font-size: 26rpx;
  color: var(--text-sub);
}

.address-row {
  margin-top: 10rpx;
}

.address-text {
  font-size: 26rpx;
  color: var(--text-main);
  line-height: 1.4;
  font-weight: 500;
}

/* 地址行带导航按钮（掌柜端商家配送跳转顾客收货地址） */
.address-row-nav {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.address-row-nav .address-text {
  flex: 1;
  min-width: 0;
}

.dist-row {
  margin-top: 8rpx;
}

.dist-text {
  font-size: 22rpx;
  color: #D48806;
  background-color: #FFFBE6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
}

/* ================= 3. 商品与费用明细卡片 ================= */
.card-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 20rpx;
  display: block;
}

.goods-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #FFF5F2;
}

.goods-item:last-of-type {
  border-bottom: none;
}

.goods-img {
  width: 130rpx;
  height: 130rpx;
  border-radius: var(--radius-img);
  background-color: #FFF5F2;
  flex-shrink: 0;
  border: 2rpx solid #FFE4E4;
}

.goods-detail {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-main);
}

.goods-spec {
  font-size: 22rpx;
  color: var(--text-sub);
  background-color: #FFF9F0;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  align-self: flex-start;
  margin-top: 4rpx;
}

.goods-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-val {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--price-color);
}

.quantity-val {
  font-size: 24rpx;
  color: var(--text-sub);
}

.remark-row {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #FFE0D6;
  font-size: 24rpx;
  line-height: 1.4;
}

.remark-label {
  color: #D48806;
  font-weight: 700;
}

.remark-content {
  color: var(--text-main);
}

.fee-item, .info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: var(--text-sub);
}

.fee-val, .info-val {
  color: var(--text-main);
  font-weight: 600;
}

.fee-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 2rpx dashed #FFE0D6;
  margin-top: 14rpx;
  padding-top: 18rpx;
}

.total-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
}

.total-val {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--price-color);
}

.copy-btn {
  font-size: 22rpx;
  color: var(--primary);
  background-color: #FFF0F0;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-round);
  margin-left: 12rpx;
  font-weight: 600;
}

/* ================= 4. 底部悬浮胶囊操作栏 ================= */
.bottom-actions {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 0 16rpx;
  background-color: rgba(255, 255, 255, 0.97);
  backdrop-filter: blur(12px);
  border: 2rpx solid #FFEAEA;
  border-radius: var(--radius-round);
  box-shadow: 0 12rpx 36rpx rgba(255, 107, 107, 0.22);
  z-index: 100;
  animation: slideUp 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.bottom-actions button {
  flex: 0 0 auto;
  width: auto;
  min-width: 0;
  height: 82rpx;
  line-height: 82rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
  margin: 0;
  border-radius: var(--radius-round);
}

/* 拒单 / 立即接单：与掌柜订单列表操作按钮保持一致 */
.bottom-actions .btn-reject {
  background-color: #FFFFFF;
  border: 2rpx solid #FFCCC7;
  color: #F5222D;
  font-weight: 800;
}

.bottom-actions .btn-accept {
  background: linear-gradient(135deg, #52C41A 0%, #73D13D 100%);
  border: none;
  color: #FFFFFF;
  font-weight: 800;
  box-shadow: 0 4rpx 14rpx rgba(82, 196, 26, 0.3);
}

/* 配送相关操作按钮：与本单配送方式标签同色系（1自取橙 / 2同城蓝 / 3外卖紫 / 4快递青） */
.bottom-actions .btn-type-1 {
  background: linear-gradient(135deg, #D4380D 0%, #FA8C16 100%);
  border: none;
  color: #FFFFFF;
  font-weight: 800;
  box-shadow: 0 4rpx 14rpx rgba(212, 56, 13, 0.28);
}

.bottom-actions .btn-type-2 {
  background: linear-gradient(135deg, #2F72D6 0%, #4D96FF 100%);
  border: none;
  color: #FFFFFF;
  font-weight: 800;
  box-shadow: 0 4rpx 14rpx rgba(47, 114, 214, 0.28);
}

.bottom-actions .btn-type-3 {
  background: linear-gradient(135deg, #7C5CD6 0%, #9B7BE8 100%);
  border: none;
  color: #FFFFFF;
  font-weight: 800;
  box-shadow: 0 4rpx 14rpx rgba(124, 92, 214, 0.28);
}

.bottom-actions .btn-type-4 {
  background: linear-gradient(135deg, #0B8A6B 0%, #20C997 100%);
  border: none;
  color: #FFFFFF;
  font-weight: 800;
  box-shadow: 0 4rpx 14rpx rgba(11, 138, 107, 0.28);
}
