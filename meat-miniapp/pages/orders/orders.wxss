/* pages/orders/orders.wxss - 订单列表页 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--bg-cream);
}

/* ================= 0. 配送方式筛选 ================= */
.type-filter-row {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 20rpx 12rpx;
  background-color: #FFFFFF;
  flex-shrink: 0;
  /* 与下方状态分类之间补一条分隔横线（与掌柜订单处理一致） */
  border-bottom: 2rpx solid #FFF2EF;
}

.type-pill {
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-round);
  background-color: #F5F5F5;
  color: var(--text-sub);
  border: 1rpx solid transparent;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.type-pill.pill-active {
  background-color: #FFF0F0;
  color: var(--primary);
  border-color: #FFCDD2;
  font-weight: 800;
}

/* ================= 1. 顶部吸顶状态筛选胶囊 ================= */
.status-tabs-scroll {
  background-color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.08);
  position: relative;
  z-index: 10;
  flex-shrink: 0;
  white-space: nowrap;
}

.status-tabs {
  display: inline-flex;
  gap: 14rpx;
  padding: 16rpx 20rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  background-color: var(--bg-pink);
  border-radius: var(--radius-round);
  font-weight: 600;
  white-space: nowrap;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.badge {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
  background-color: #FF3B30;
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 1;
  height: 32rpx;
  min-width: 32rpx;
  padding: 0 10rpx;
  border-radius: 16rpx;
  text-align: center;
  font-weight: 800;
  margin-left: 8rpx;
}

.tab-item.tab-active .badge {
  background-color: #FFFFFF;
  color: #D32F2F;
}

.tab-item.tab-active {
  background: var(--primary-gradient);
  color: #FFFFFF;
  font-weight: 800;
  box-shadow: 0 4rpx 14rpx rgba(255, 107, 107, 0.3);
  transform: translateY(-2rpx);
}

/* ================= 2. 订单列表 ================= */
.order-list {
  flex: 1;
  height: 100%;
  padding: 8rpx 0 calc(160rpx + env(safe-area-inset-bottom));
}

.order-card {
  margin: 20rpx 24rpx;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-warm);
  border: 2rpx solid #FFF2EF;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  animation: fadeIn 0.3s ease-out;
}

.order-card:active {
  transform: scale(0.985);
}

/* 头部：配送标签 + 单号 + 状态软色标签 */
.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx dashed #FFE4DC;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.delivery-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 36rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  font-size: 19rpx;
  line-height: 1;
  font-weight: 700;
  white-space: nowrap;
  border-radius: var(--radius-round);
}

.pickup-pill {
  font-size: 20rpx;
  font-weight: 700;
  color: #FF5722;
  background: #FFF0EB;
  border: 1rpx solid #FFCCBC;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  letter-spacing: 1rpx;
}

/* 下单时间 */
.order-time-row {
  margin-top: 12rpx;
}

.order-time {
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.3;
}

/* ================= 3. 商品缩略图横排 ================= */
.thumb-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
}

/* 图片区最多占屏幕一半（50vw），避免图片把右侧文案挤压变形 */
.thumb-group {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 50vw;
}

.thumb {
  width: 84rpx;
  height: 84rpx;
  border-radius: 16rpx;
  background-color: #FFF5F2;
  border: 2rpx solid #FFEDE7;
  flex-shrink: 0;
}

/* 商品超出展示数量时的省略号：纯文字，无底色/边框 */
.thumb-more {
  flex-shrink: 0;
  color: var(--text-light);
  font-size: 26rpx;
  line-height: 1;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

.thumb-summary {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.summary-name {
  max-width: 100%;
  font-size: 24rpx;
  color: var(--text-main);
  font-weight: 700;
}

.summary-count {
  font-size: 22rpx;
  color: var(--text-sub);
  background-color: #FFF7F3;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

/* ================= 4. 底部金额与胶囊操作按钮 ================= */
.order-footer {
  padding-top: 18rpx;
  border-top: 2rpx dashed #FFE4DC;
}

.total-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 10rpx;
}

.pay-method {
  font-size: 21rpx;
  color: var(--text-light);
  margin-right: auto;
}

.original-amount {
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
  margin-right: 6rpx;
}

.total-amount-label {
  font-size: 23rpx;
  color: var(--text-main);
  font-weight: 600;
}

.total-amount {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--price-color);
}

.action-buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.action-buttons button {
  /* 覆盖微信 button 默认整行宽度，改为按文字内容自适应的小胶囊 */
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: auto;
  min-width: 0;
  max-width: 100%;
  margin: 0;
  padding: 0 22rpx;
  height: 54rpx;
  line-height: 1;
  font-size: 23rpx;
  font-weight: 700;
  white-space: nowrap;
  border-radius: var(--radius-round);
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.action-buttons button:active {
  transform: scale(0.94);
}

.btn-cancel {
  background-color: #FFFFFF;
  color: var(--text-sub);
  border: 2rpx solid #EAEAEA;
}

.btn-pay {
  background: var(--primary-gradient);
  color: #FFFFFF;
  font-weight: 800;
  box-shadow: 0 4rpx 14rpx rgba(255, 107, 107, 0.3);
}

.btn-confirm {
  /* 与订单详情的「确认收货」主按钮保持一致：主色红 */
  background: var(--primary-gradient);
  color: #FFFFFF;
  font-weight: 800;
  box-shadow: 0 4rpx 14rpx rgba(255, 107, 107, 0.3);
}

.load-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: var(--text-light);
}
