<!-- pages/orders/orders.wxml -->
<view class="container">
  <!-- 顶部筛选区（吸顶） -->
  <view class="filter-header">
    <!-- 配送方式筛选：全部 / 仅到店自取 / 仅同城配送 / 仅快递配送 -->
    <view class="type-filter-row">
      <view class="type-pill {{deliveryType === '' ? 'pill-active' : ''}}" bindtap="onDeliveryTypeChange" data-type="">
        全部配送
      </view>
      <view class="type-pill {{deliveryType === 1 ? 'pill-active' : ''}}" bindtap="onDeliveryTypeChange" data-type="{{1}}">
        仅到店自取
      </view>
      <view class="type-pill {{deliveryType === 2 ? 'pill-active' : ''}}" bindtap="onDeliveryTypeChange" data-type="{{2}}">
        仅同城配送
      </view>
      <view class="type-pill {{deliveryType === 4 ? 'pill-active' : ''}}" bindtap="onDeliveryTypeChange" data-type="{{4}}">
        仅快递配送
      </view>
    </view>

    <!-- 顶部状态筛选胶囊 -->
    <scroll-view class="status-tabs-scroll" scroll-x enable-flex>
      <view class="status-tabs">
        <view wx:for="{{tabs}}" wx:key="status" class="tab-item {{currentStatus === item.status ? 'tab-active' : ''}}" bindtap="onSwitchTab" data-status="{{item.status}}">
          <text>{{item.label}}</text>
          <view class="badge" wx:if="{{statusCounts[item.countKey] > 0}}">{{statusCounts[item.countKey] > 99 ? '99+' : statusCounts[item.countKey]}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 订单列表：直接随页面滚动，下拉即触发系统自带的下拉刷新 -->
  <view class="order-list">
    <view wx:if="{{orderList.length === 0 && !loading}}" class="empty-box">
      <text class="empty-icon">🍖</text>
      <text class="empty-text">{{deliveryType === '' ? '还没有订单哦～' : '没有该配送方式的订单'}}</text>
      <view class="empty-btn" bindtap="goToHome">去逛逛</view>
    </view>

    <!-- 首屏加载动画 -->
    <view class="loading-more page-loading" wx:if="{{loading && orderList.length === 0}}">
      <text class="loading-meat-icon">🥩</text>
      <text class="loading-more-text">正在准备今日订单...</text>
    </view>

    <view wx:for="{{orderList}}" wx:key="id" class="order-card" bindtap="goToDetail" data-id="{{item.id}}">
      <!-- 订单头：配送方式 + 状态软色标签 -->
      <view class="order-header">
        <view class="header-left">
          <text class="delivery-badge dlv-{{item.deliveryType}}">{{item.deliveryTypeDesc}}</text>
          <text class="pickup-pill" wx:if="{{item.deliveryType === 1 && item.pickupCode}}">提货码 {{item.pickupCode}}</text>
        </view>
        <text class="status-chip st-{{item.status}}">{{item.statusDesc}}</text>
      </view>

      <!-- 下单时间与期望送达/自取时间 -->
      <view class="order-time-row">
        <text class="order-time">下单时间：{{item.createTime}}</text>
        <view class="expected-time-chip" wx:if="{{item.expectedTimeStr && item.status !== 4}}">{{item.deliveryType === 1 ? '期望自取' : '期望送达'}} {{item.expectedTimeStr}}</view>
      </view>

      <!-- 商品缩略图横排：图片区最多占屏幕 50%，超出时用「更多」提示 -->
      <view class="thumb-row">
        <view class="thumb-group">
          <block wx:for="{{item.items}}" wx:key="id" wx:for-item="goods">
            <image wx:if="{{index < (item.items.length > 4 ? 3 : 4)}}" class="thumb" src="{{goods.productImage}}" mode="aspectFill"/>
          </block>
          <view class="thumb-more" wx:if="{{item.items.length > 4}}">...</view>
        </view>

        <view class="thumb-summary">
          <text class="summary-name ellipsis">{{item.items[0].productName}}</text>
          <text class="summary-count">共 {{item.items.length}} 件</text>
        </view>
      </view>

      <!-- 底部汇总与操作按钮 -->
      <view class="order-footer">
        <view class="total-row">
          <text class="pay-method">[{{item.payTypeDesc}} · {{item.payStatusDesc}}]</text>
          <text class="original-amount" wx:if="{{item.originalPayAmount && item.originalPayAmount != item.payAmount}}">原¥{{item.originalPayAmount}}</text>
          <text class="total-amount-label">实付</text>
          <text class="total-amount">¥{{item.payAmount}}</text>
        </view>

        <view class="action-buttons" wx:if="{{item.canCancel || item.canPay || item.canConfirm}}" catchtap="preventBubble">
          <button class="btn-cancel" wx:if="{{item.canCancel}}" catchtap="onCancelOrder" data-id="{{item.id}}">
            取消订单
          </button>
          <button class="btn-pay" wx:if="{{item.canPay}}" catchtap="onPayOrder" data-id="{{item.id}}">
            立即支付
          </button>
          <button class="btn-confirm" wx:if="{{item.canConfirm}}" catchtap="onConfirmOrder" data-id="{{item.id}}">
            确认收货
          </button>
        </view>
      </view>
    </view>

    <view class="load-more" wx:if="{{orderList.length > 0}}">
      <view class="loading-more" wx:if="{{loadingMore}}">
        <text class="loading-meat-icon">🥩</text>
        <text class="loading-more-text">正在取订单...</text>
      </view>
      <text wx:elif="{{hasMore}}">上拉加载更多...</text>
      <text wx:else>已加载全部订单</text>
    </view>
  </view>
</view>
