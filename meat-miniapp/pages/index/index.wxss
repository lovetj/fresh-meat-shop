/* pages/index/index.wxss - 选肉首页 */

/* 整页固定高度：横幅与搜索固定，下方分类/商品各自独立滚动 */
.page-shell {
  height: 100vh;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: var(--bg-cream);
  /* 底部预留自定义 tabBar 高度（108rpx + 16rpx + 安全区） */
  padding-bottom: calc(124rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  /* 筛选区域统一字号：左侧分类与排序栏保持一致 */
  --fs-filter: 22rpx;
}

/* ================= 1. 顶部卡通店铺横幅 ================= */
.shop-banner {
  position: relative;
  flex-shrink: 0;
  overflow: hidden;
  padding: 32rpx 32rpx 28rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 55%, #FFA98F 100%);
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 10rpx 28rpx rgba(255, 107, 107, 0.22);
  color: #FFFFFF;
}

/* 背景卡通装饰 */
.banner-deco {
  position: absolute;
  right: 20rpx;
  bottom: -24rpx;
  font-size: 150rpx;
  opacity: 0.16;
  transform: rotate(-12deg);
  pointer-events: none;
}

.banner-deco-2 {
  position: absolute;
  right: 170rpx;
  top: 20rpx;
  font-size: 80rpx;
  opacity: 0.12;
  transform: rotate(14deg);
  pointer-events: none;
}

.shop-brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.shop-title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.shop-name {
  max-width: 380rpx;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 6rpx rgba(160, 40, 40, 0.18);
}

.switch-shop-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 14rpx;
  background-color: rgba(255, 255, 255, 0.28);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: var(--radius-round);
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 600;
  white-space: nowrap;
}

.switch-arrow {
  font-size: 16rpx;
  margin-top: 2rpx;
}

.shop-status {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-round);
  font-size: 22rpx;
  font-weight: 700;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: currentColor;
}

/* 状态标签可点击查看营业时间 */
.shop-status-hover {
  opacity: 0.82;
}

.is-open {
  background-color: rgba(255, 255, 255, 0.94);
  color: #2E9E4F;
}

.is-close {
  background-color: rgba(255, 255, 255, 0.86);
  color: #E68600;
}

.is-closed {
  background-color: rgba(255, 255, 255, 0.86);
  color: #8A8A8A;
}

/* 休息中 / 歇业中 提示条 */
.shop-state-tip {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.tip-rest {
  background-color: rgba(255, 255, 255, 0.9);
  color: #B26A00;
}

.tip-closed {
  background-color: rgba(255, 255, 255, 0.9);
  color: #8A8A8A;
}

.shop-slogan {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #FFF3F0;
  position: relative;
  z-index: 1;
}

.shop-addr {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  background-color: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  position: relative;
  z-index: 1;
}

.addr-text {
  flex: 1;
  font-size: 24rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.addr-nav {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--cream-yellow);
  white-space: nowrap;
}

/* 公告跑马灯 */
.notice-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 10rpx 18rpx;
  border-radius: 18rpx;
  background-color: rgba(255, 249, 230, 0.95);
  border: 1rpx solid #FFE58F;
  position: relative;
  z-index: 1;
}

.notice-label {
  font-size: 24rpx;
  flex-shrink: 0;
}

.notice-track {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  overflow: hidden;
  height: 36rpx;
}

.notice-marquee {
  display: block;
  flex: 0 0 auto;
  white-space: nowrap;
  font-size: 22rpx;
  line-height: 1;
  color: #874D00;
  font-weight: 600;
  padding-left: 100%;
}

/* ================= 2. 搜索胶囊 ================= */
.search-box {
  flex-shrink: 0;
  padding: 24rpx var(--gutter) 4rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: var(--radius-round);
  padding: 8rpx 28rpx;
  border: 2rpx solid #FFE4E4;
  box-shadow: 0 6rpx 18rpx rgba(255, 107, 107, 0.08);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  height: 66rpx;
  font-size: 26rpx;
  color: var(--text-main);
}

.clear-btn {
  font-size: 26rpx;
  color: #FFFFFF;
  background-color: #E6E6E6;
  width: 38rpx;
  height: 38rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
}

/* ================= 3. 左右布局：左侧分类 + 右侧商品 ================= */
.catalog-layout {
  flex: 1;
  min-height: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx var(--gutter) 8rpx;
  overflow: hidden;
  /* 左右占比：按屏宽动态分配，分类栏约占 1/4，商品区自动占满剩余空间 */
  --category-ratio: 25%;
}

/* 左侧分类栏：宽度按屏宽比例分配，并以「4 个字」宽度作为下限，独立滚动 */
.category-sidebar {
  flex: 0 0 var(--category-ratio);
  width: var(--category-ratio);
  /* 4em 为 4 个汉字的宽度，36rpx 为内边距 + 边框 + 滚动条预留 */
  min-width: calc(4em + 36rpx);
  font-size: var(--fs-filter);
  height: 100%;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 2rpx 2rpx 24rpx;
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 12rpx;
  border-radius: 20rpx;
  background-color: #FFFFFF;
  border: 2rpx solid #FFF2EF;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.05);
  transition: all 0.2s ease;
}

.category-item:active {
  transform: scale(0.96);
}

.category-item-active {
  background: var(--primary-gradient);
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 107, 0.28);
}

/* 文字居中，铺满分类项宽度（至少可容纳 4 个字），超出省略；字号与排序栏一致 */
.category-text {
  width: 100%;
  font-size: var(--fs-filter);
  line-height: 1.2;
  font-weight: 400;
  color: var(--text-main);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-item-active .category-text {
  color: #FFFFFF;
}

/* 右侧商品区：排序栏固定，商品列表独立滚动 */
.goods-panel {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.goods-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

/* 底部留白，保证最后一张卡片能滚动到悬浮购物车球上方 */
.goods-scroll-inner {
  padding-bottom: 150rpx;
}

/* ================= 3.1 排序栏（商品区顶部，价格在前、销量在后） ================= */
.sort-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.sort-bar-label {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-right: 4rpx;
  color: var(--text-sub);
  font-size: var(--fs-filter);
  font-weight: 600;
}

.sort-bar-icon {
  font-size: var(--fs-filter);
  line-height: 1;
}

.sort-item {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-round);
  background-color: #FFFFFF;
  border: 2rpx solid #FFE9E4;
  color: var(--text-main);
  font-size: var(--fs-filter);
  font-weight: 600;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.sort-item:active {
  transform: scale(0.95);
}

.sort-item-active {
  background: var(--primary-gradient);
  border-color: transparent;
  color: #FFFFFF;
  font-weight: 800;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 107, 0.25);
}

.sort-item-text {
  line-height: 1;
}

/* 价格的双向箭头：未选中时浅灰，选中的方向高亮 */
.sort-arrows {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.sort-arrow {
  font-size: 14rpx;
  line-height: 12rpx;
  color: #C9C9C9;
  transition: color 0.2s ease;
}

.sort-arrow.is-up,
.sort-arrow.is-down {
  color: var(--primary);
}

.sort-item-active .sort-arrow {
  color: rgba(255, 255, 255, 0.5);
}

.sort-item-active .sort-arrow.is-up,
.sort-item-active .sort-arrow.is-down {
  color: #FFFFFF;
}

.sort-arrow.is-down-const {
  font-size: 16rpx;
  line-height: 1;
  color: #C9C9C9;
}

.sort-item-active .sort-arrow.is-down-const {
  color: #FFFFFF;
}

/* ================= 4. 右侧商品单列横向卡片 ================= */
.goods-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.goods-card {
  display: flex;
  gap: 16rpx;
  width: 100%;
  background-color: #FFFFFF;
  border-radius: var(--radius-card);
  padding: 14rpx;
  box-shadow: var(--shadow-warm);
  border: 2rpx solid #FFF2EF;
  overflow: hidden;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  animation: fadeIn 0.3s ease-out;
}

.goods-card:active {
  transform: scale(0.975);
}

.goods-thumb-wrap {
  position: relative;
  flex: 0 0 180rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-img);
  overflow: hidden;
  background-color: #FFF5F2;
}

.goods-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

/* 骨架屏缩略图：与商品图同尺寸 */
.skeleton-thumb {
  flex: 0 0 180rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-img);
}

/* 左上角特价角标 */
.corner-badge {
  position: absolute;
  left: 0;
  top: 0;
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #FFFFFF;
  border-radius: var(--radius-img) 0 16rpx 0;
  letter-spacing: 1rpx;
}

.badge-sale {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  animation: pulseGlow 2.6s ease-in-out infinite;
}

/* 价格行右侧的圆形“+”加购按钮 */
.quick-add {
  flex-shrink: 0;
  margin-left: auto;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--primary-gradient);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 45rpx;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 107, 0.4);
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.quick-add:active {
  transform: scale(0.86);
}

/* 门店歇业中：加购按钮置灰 */
.quick-add-disabled {
  background: #D9D9D9;
  box-shadow: none;
  color: #FFFFFF;
}

/* 门店歇业中：结算按钮置灰但保留点击（点击给出歇业说明） */
.cart-checkout-btn.cart-checkout-closed {
  background: #E0E0E0;
  color: #9E9E9E;
  box-shadow: none;
}

.goods-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 2rpx 0;
}

.goods-name {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-main);
  line-height: 1.35;
}

.goods-summary {
  display: block;
  font-size: 20rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

.goods-tags {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.mini-tag {
  font-size: 19rpx;
  color: var(--text-sub);
  background-color: #FFF7F3;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.mini-tag-warn {
  color: #D46B08;
  background-color: #FFF7E6;
}

.goods-price-row {
  display: flex;
  align-items: center;
  margin-top: auto;
  padding-top: 10rpx;
}

/* 横向卡片内价格字号略收，避免与加购按钮挤在一起 */
.goods-card .price-value {
  font-size: 34rpx;
}

.goods-card .price-original {
  font-size: 20rpx;
  margin-left: 6rpx;
}

/* ================= 5. 加载态与空状态 ================= */
.load-more {
  text-align: center;
  padding: 36rpx 0 20rpx;
  font-size: 24rpx;
  color: var(--text-light);
}

/* 右侧商品区较窄，空态与加载提示紧凑展示 */
.goods-panel .load-more {
  padding: 28rpx 0 16rpx;
  font-size: 22rpx;
}

.goods-empty {
  padding: 90rpx 10rpx;
}

.goods-empty .empty-icon {
  font-size: 76rpx;
  margin-bottom: 16rpx;
}

.goods-empty .empty-text {
  font-size: 24rpx;
}

.goods-empty .empty-sub {
  font-size: 20rpx;
  line-height: 1.5;
}

.goods-empty .empty-btn {
  height: 64rpx;
  padding: 0 30rpx;
  line-height: 64rpx;
  font-size: 24rpx;
}

/* ================= 6. 规格选购弹窗 ================= */
.spec-sheet {
  max-height: 84vh;
  overflow-y: auto;
  /* tabBar 打开弹层时已隐藏，底部留出安全距离，保证「加入购物车」按钮完整可点 */
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: var(--radius-round);
  background-color: #FFE0DA;
  margin: -12rpx auto 24rpx;
}

.spec-header {
  display: flex;
  position: relative;
  border-bottom: 2rpx dashed #FFE4DC;
  padding-bottom: 26rpx;
}

.spec-thumb {
  width: 152rpx;
  height: 152rpx;
  border-radius: var(--radius-img);
  flex-shrink: 0;
  background-color: #FFF5F2;
  border: 2rpx solid #FFE4E4;
}

.spec-info {
  flex: 1;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  padding-right: 40rpx;
}

.spec-name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main);
}

.spec-selected {
  font-size: 22rpx;
  color: var(--text-sub);
  background-color: #FFF9F0;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  align-self: flex-start;
}

.close-x {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-sub);
  background-color: #F7F7F7;
  border-radius: 50%;
}

.spec-group {
  margin-top: 24rpx;
}

.spec-step-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.spec-step-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: var(--primary);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 800;
}

.spec-step-tip {
  font-size: 22rpx;
  color: var(--text-light);
  margin-left: 6rpx;
}

.spec-step-tip.tip-warn {
  color: #FF6B6B;
}

.spec-step-two {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #FFE4DC;
}

.spec-empty-hint {
  font-size: 24rpx;
  color: var(--text-light);
  padding: 14rpx 0 6rpx;
}

.spec-group-title {
  font-size: 27rpx;
  font-weight: 800;
  color: var(--text-main);
  display: block;
}

.spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.opt-btn {
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  background-color: var(--bg-pink);
  border-radius: var(--radius-round);
  color: var(--text-main);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.opt-btn.opt-active {
  background-color: #FFF0F0;
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.2);
}

.quantity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 32rpx;
  padding-top: 26rpx;
  border-top: 2rpx dashed #FFE4DC;
}

.quantity-info {
  flex: 1 1 auto;
  min-width: 0;
}

.quantity-title {
  display: block;
  margin-bottom: 6rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
  color: var(--text-main);
  white-space: nowrap;
}

.quantity-unit {
  display: block;
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--text-light);
  white-space: nowrap;
}

/* 萌趣步进器 */
.stepper {
  flex: 0 0 auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: nowrap;
  background-color: #FFF5F2;
  border-radius: var(--radius-round);
  padding: 4rpx;
}

.step-btn {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  min-width: 58rpx;
  max-width: 58rpx;
  padding: 0;
  margin: 0;
  line-height: 1;
  font-size: 32rpx;
  background-color: #FFFFFF;
  color: var(--primary);
  font-weight: 800;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.15s ease;
}

.step-btn:active {
  transform: scale(0.88);
}

.step-val {
  flex: 0 0 auto;
  min-width: 64rpx;
  line-height: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-main);
  margin: 0 6rpx;
}

.spec-footer {
  margin-top: 40rpx;
}

.confirm-buy-btn {
  width: 100%;
  height: 88rpx;
  font-size: 32rpx;
  font-weight: 800;
  border-radius: var(--radius-round);
}

/* ================= 7. 切换门店半屏弹窗 ================= */
/* 弹窗层级需高于底部自定义 tabBar(500)，同时打开时隐藏 tabBar */
.shop-modal-mask {
  z-index: 1000;
  /* 关闭高斯模糊：backdrop-filter 叠加位移动画在低端机容易掉帧 */
  backdrop-filter: none;
  background-color: rgba(61, 61, 61, 0.55);
  animation: shopMaskFade 0.2s ease-out;
}

.shop-modal-panel {
  max-height: 80vh;
  padding: 36rpx 28rpx calc(50rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  box-sizing: border-box;
  animation: shopSheetUp 0.28s cubic-bezier(0.22, 0.61, 0.36, 1);
}

@keyframes shopMaskFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 首页悬浮球位置：贴近自定义tabBar上方 */
.index-cart-ball {
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  z-index: 600;
}

@keyframes shopSheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.shop-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.shop-modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-main);
}

.shop-modal-tips {
  font-size: 24rpx;
  color: var(--text-light);
  margin-bottom: 24rpx;
}

/* 门店名称搜索 */
.shop-search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  background-color: #F7F7F7;
  border: 2rpx solid #EFEFEF;
  border-radius: var(--radius-round);
  box-sizing: border-box;
}

.shop-search-icon {
  flex-shrink: 0;
  margin-right: 10rpx;
  font-size: 26rpx;
}

.shop-search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 26rpx;
  color: var(--text-main);
}

.shop-search-placeholder {
  color: var(--text-light);
}

.shop-search-clear {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #FFFFFF;
  background-color: #D9D9D9;
  border-radius: 50%;
}

/* 分页加载状态 / 空态 */
.shop-list-footer {
  padding: 16rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
}

.shop-list-scroll {
  max-height: 50vh;
}

.shop-item-card {
  position: relative;
  background-color: #FAFAFA;
  border: 2rpx solid #EFEFEF;
  border-radius: 24rpx;
  padding: 24rpx 24rpx;
  margin-bottom: 20rpx;
  transition: all 0.2s ease;
}

.shop-item-selected {
  background-color: #FFF6F5;
  border-color: var(--primary);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.15);
}

.shop-item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.shop-item-name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-main);
  flex: 1;
}

.shop-item-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.shop-tag-dist {
  font-size: 20rpx;
  color: var(--primary);
  background-color: #FFEAE6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 700;
}

.shop-tag-status {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 700;
}

/* 三态：1-营业中, 2-休息中, 3-歇业中 */
.tag-s1 {
  background-color: #E6F7ED;
  color: #2E9E4F;
}

.tag-s2 {
  background-color: #FFF4E5;
  color: #E68600;
}

.tag-s3 {
  background-color: #F0F0F0;
  color: #8C8C8C;
}

.shop-item-addr {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 14rpx;
  line-height: 1.4;
}

.shop-item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
}

.shop-meta-tag {
  background-color: #FFFFFF;
  border: 1rpx solid #EAEAEA;
  color: var(--text-light);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.shop-item-check {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 700;
  text-align: right;
}
