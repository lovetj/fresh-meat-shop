<!-- custom-tab-bar/index.wxml - Q萌卡通 tabBar -->
<view class="tabbar-wrap" wx:if="{{!hidden}}">
  <view class="tabbar">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'tab-active' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-icon-wrap">
        <text class="tab-icon">{{item.icon}}</text>
      </view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
