/* custom-tab-bar/index.wxss - Q萌卡通底部导航 */

.tabbar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
  padding: 0 24rpx calc(16rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tabbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 108rpx;
  padding: 0 16rpx;
  background-color: #FFFFFF;
  border-radius: 36rpx;
  border: 2rpx solid #FFF0ED;
  box-shadow: 0 10rpx 28rpx rgba(255, 107, 107, 0.16);
  pointer-events: auto;
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  font-size: 42rpx;
  line-height: 1;
  filter: grayscale(1);
  opacity: 0.45;
  transition: all 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8A8A8A;
  font-weight: 600;
  transition: color 0.25s ease;
}

/* 选中态：主色 + 轻微上浮 */
.tab-active {
  transform: translateY(-10rpx);
}

.tab-active .tab-icon {
  filter: none;
  opacity: 1;
  transform: scale(1.12);
}

.tab-active .tab-text {
  color: #FF6B6B;
  font-weight: 800;
}
